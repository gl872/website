---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ClosingStart from "../../components/ClosingStart.astro";
import PostCard from "../../components/blog/PostCard.astro";
import ThreadArt from "../../components/blog/ThreadArt.astro";
import author from "../../data/author.json";
import { CATEGORY, fmtDate, getPublishedPosts, readTime, splitHighlight, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 3) },
  }));
}

interface Props {
  post: Post;
  more: Post[];
}
const { post, more } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const c = CATEGORY[d.type];
const titleParts = splitHighlight(d.title, d.highlight);
const minutes = readTime(post.body);

// The author card and byline photo come from src/data/author.json (editable in Pages CMS)
// when the post's author is that person. Other authors get a name-only byline.
const isHouseAuthor = d.author === author.name;

const site = Astro.site ?? new URL("https://krue.io");
const url = new URL(`/blog/${post.id}`, site).toString();
const image = new URL(d.cover ?? "/og-image.png", site).toString();
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.excerpt,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  articleSection: d.type,
  inLanguage: "en-US",
  image,
  url,
  mainEntityOfPage: url,
  author: { "@type": "Person", name: d.author, ...(isHouseAuthor ? { jobTitle: author.role } : {}) },
  publisher: {
    "@type": "Organization",
    name: "Krue",
    logo: { "@type": "ImageObject", url: new URL("/assets/logos/krue-wordmark-navy.png", site).toString() },
  },
};
---

<Base title={`${d.title} · Krue`} description={d.excerpt} path={`/blog/${post.id}`} ogType="article" ogImage={d.cover}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <main>
    <section class="p-wrap" style="padding-top:clamp(40px,6vw,80px)">
      <a class="p-back" href="/blog/">← All posts</a>
      <p class="b-tag" style={`margin:28px 0 14px;color:${c.label}`}>{d.type}</p>
      <h1 style="margin:0;font:800 clamp(38px,5.6vw,64px)/1.04 var(--font-display);letter-spacing:-0.04em;color:#14325A;text-wrap:balance">
        {titleParts ? (
          <Fragment>{titleParts[0]}<span class="k-hl" style={`--hl:${c.hl}`}>{titleParts[1]}</span>{titleParts[2]}</Fragment>
        ) : d.title}
      </h1>
      <p style="margin:20px 0 0;font:400 clamp(19px,1.7vw,22px)/1.55 var(--font-body);color:#3B4656;text-wrap:pretty">{d.excerpt}</p>
      <div style="margin-top:24px;display:flex;align-items:center;gap:12px;font:500 14px/1.3 var(--font-body);color:#69727F">
        {isHouseAuthor && <img src={author.photo} alt="" width="40" height="40" style="width:40px;height:40px;border-radius:50%;object-fit:cover" />}
        <span><b style="color:#14325A;font-weight:700">{d.author}</b><br /><time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time> · {minutes} min read</span>
      </div>
    </section>

    <section style="max-width:1000px;margin:clamp(32px,4vw,48px) auto 0;padding:0 clamp(16px,4vw,40px)">
      <div style="border-radius:28px;overflow:hidden">
        <div class="b-cover" style={`background:${c.tint};aspect-ratio:2/1`}>
          {d.cover ? <img src={d.cover} alt={d.coverAlt ?? ""} /> : <ThreadArt line={c.line} />}
        </div>
      </div>
    </section>

    <article class="p-wrap p-body" style="padding-top:clamp(36px,4vw,56px)">
      {d.in_short.length > 0 && (
        <div class="p-short"><b>In short</b><ul>{d.in_short.map((s) => <li>{s}</li>)}</ul></div>
      )}

      <Content />

      <p class="p-note">This post is for general information and isn't medical advice. Talk with your care team about your own health.</p>

      {isHouseAuthor && (
        <div class="p-author">
          <img src={author.photo} alt={author.name} width="64" height="64" />
          <div><b style="display:block;font:700 16px/1.3 var(--font-display);color:#14325A">{author.name}</b><span style="font:400 14.5px/1.5 var(--font-body);color:#3B4656">{author.bio || author.role}</span></div>
        </div>
      )}
    </article>

    {more.length > 0 && (
      <section class="b-wrap" style="padding-top:clamp(64px,8vw,110px)">
        <h2 style="margin:0 0 24px;font:800 clamp(28px,3vw,38px)/1.1 var(--font-display);letter-spacing:-0.03em;color:#14325A">More from the blog</h2>
        <div class="b-grid">{more.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}

    <ClosingStart />
  </main>
</Base>
