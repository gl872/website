---
// Google Tag Manager + a minimal cookie-consent banner, entirely inert unless
// PUBLIC_GTM_ID is set. GTM's own install instructions require two separate
// snippets — one in <head>, one right after <body> opens — so this component
// takes a `placement` prop and is included twice from Base.astro.
//
// Consent rules (Google Consent Mode v2). Krue is a health site, so:
// - Everything defaults to denied. Before a choice, or after Decline, nothing
//   non-essential runs.
// - Accept grants analytics_storage ONLY. ad_storage, ad_user_data and
//   ad_personalization are never granted. An ad pixel on pages about chronic
//   illness would count as sharing health information.
// - A Global Privacy Control signal is treated as Decline, and the banner is not shown.
// The GTM container must hold no ad pixels or session-recording tags.
interface Props {
  placement: "head" | "body";
}
const { placement } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
---

{placement === "head" && gtmId && (
  <>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
    </script>
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
  </>
)}

{placement === "body" && gtmId && (
  <>
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <div id="cookie-consent" class="cc" role="region" aria-label="Cookie choices" hidden>
      <p>We use analytics cookies to understand site traffic and improve Krue. No ads or tracking pixels. <a href="/privacy/#cookies">Learn more</a></p>
      <div class="cc-acts">
        <button type="button" id="cookie-decline" class="cc-no">Decline</button>
        <button type="button" id="cookie-accept" class="cc-yes">Accept</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'krue-cookie-consent';
        var banner = document.getElementById('cookie-consent');
        var accept = document.getElementById('cookie-accept');
        var decline = document.getElementById('cookie-decline');
        if (!banner || !accept || !decline) return;

        // Only analytics is ever granted. Ad signals stay denied in every case.
        function update(granted) {
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('consent', 'update', {
            analytics_storage: granted ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
        }
        function hide() {
          banner.classList.remove('cc-in');
          setTimeout(function () { banner.hidden = true; }, 300);
        }

        // Global Privacy Control means Decline, without asking.
        if (navigator.globalPrivacyControl === true) {
          update(false);
          return;
        }

        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}

        if (stored === 'granted') {
          update(true);
        } else if (stored === 'denied') {
          update(false);
        } else {
          banner.hidden = false;
          requestAnimationFrame(function () { banner.classList.add('cc-in'); });
        }

        accept.addEventListener('click', function () {
          try { localStorage.setItem(KEY, 'granted'); } catch (e) {}
          update(true);
          hide();
        });
        decline.addEventListener('click', function () {
          try { localStorage.setItem(KEY, 'denied'); } catch (e) {}
          update(false);
          hide();
        });
      })();
    </script>
  </>
)}
