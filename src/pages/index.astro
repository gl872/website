    <div style="max-width:1180px;margin:0 auto;padding:clamp(28px,4vw,40px) clamp(16px,4vw,40px);box-sizing:border-box;display:flex;flex-direction:column;align-items:center;gap:20px">
      <p style="margin:0;font:700 12px/1 var(--font-display);letter-spacing:.16em;text-transform:uppercase;color:#69727F;text-align:center">Supported by</p>
