---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · Krue" description="This page doesn't exist." path="/404" noindex>
  <main>
    <section class="p-wrap" style="padding-top:clamp(64px,10vw,140px);padding-bottom:clamp(80px,11vw,160px)">
      <p style="margin:0 0 14px;font:700 13px/1 var(--font-display);letter-spacing:.16em;text-transform:uppercase;color:#69727F">404</p>
      <h1 style="margin:0;font:800 clamp(38px,5vw,60px)/1.04 var(--font-display);letter-spacing:-0.035em;color:#14325A;text-wrap:balance">This page <span class="k-hl" style="--hl:#F9D3E4">got lost.</span></h1>
      <p style="margin:18px 0 0;font:400 clamp(18px,1.6vw,21px)/1.55 var(--font-body);color:#3B4656;text-wrap:pretty">The link may be old, or the page may have moved.</p>
      <div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:12px">
        <a href="/" style="display:inline-flex;text-decoration:none;background:#E0EE40;color:#14325A;font:700 17px/1 var(--font-display);padding:18px 28px;border-radius:999px">Go to the home page</a>
        <a href="/blog/" style="display:inline-flex;text-decoration:none;color:#14325A;box-shadow:inset 0 0 0 1.5px #14325A;font:700 17px/1 var(--font-display);padding:18px 28px;border-radius:999px">Read the blog</a>
      </div>
    </section>
  </main>
</Base>
