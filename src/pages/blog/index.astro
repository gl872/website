---
import Base from "../../layouts/Base.astro";
import ClosingStart from "../../components/ClosingStart.astro";
import PostCard from "../../components/blog/PostCard.astro";
import ThreadArt from "../../components/blog/ThreadArt.astro";
import { CATEGORY, PILL, featuredFirst, fmtDate, getPublishedPosts, postUrl, readTime } from "../../lib/blog";

// Every post renders twice: once as a (hidden) featured card and once as a grid card.
// src/scripts/blog.js shows the first post matching the active filter as the featured card
// and hides it from the grid. Server-side defaults match the "All" filter, so it also works without JS.
const posts = featuredFirst(await getPublishedPosts());
const categories = [...new Set(posts.map((p) => p.data.type))];
const showFilters = categories.length >= 2;
const showGrid = posts.length >= 2;
const FILTERS = ["All", ...(["Company news", "Articles", "Practical guides"] as const).filter((c) => categories.includes(c))] as const;
---

<Base
  title="Blog · Krue"
  description="What we're building, and practical ideas for life with a complex chronic illness."
  path="/blog"
>
  <main>
    <section class="b-wrap" style="padding-top:clamp(56px,8vw,110px)">
      <p class="b-eb">The Krue blog</p>
      <h1 style="margin:0;font:800 clamp(44px,7vw,88px)/1 var(--font-display);letter-spacing:-0.045em;color:#14325A;text-wrap:balance">Notes from <span class="k-hl" style="--hl:#C4EBF9">Krue.</span></h1>
      <p style="margin:24px 0 0;max-width:40rem;font:400 clamp(18px,1.6vw,21px)/1.6 var(--font-body);color:#3B4656;text-wrap:pretty">What we're building, and practical ideas for life with a complex chronic illness.</p>
      {showFilters && (
        <div role="group" aria-label="Filter posts" style="margin-top:clamp(32px,4vw,48px);display:flex;flex-wrap:wrap;gap:8px">
          {FILTERS.map((f, i) => {
            const [bg, fg, bgh, fgh] = PILL[f];
            const sel = i === 0;
            return (
              <button type="button" class="h-pill b-filter" aria-pressed={String(sel)} data-filter={f} style={`--bg:${sel ? bgh : bg};--fg:${sel ? fgh : fg};--bgh:${bgh};--fgh:${fgh}`}>{f}</button>
            );
          })}
        </div>
      )}
    </section>

    <section class="b-wrap" style="padding-top:clamp(32px,4vw,48px)">
      {posts.length === 0 && (
        <p style="margin:0;font:400 18px/1.6 var(--font-body);color:#3B4656">The first post is on its way.</p>
      )}
      {posts.map((post, i) => {
        const c = CATEGORY[post.data.type];
        return (
          <a class="b-card b-feat" data-idx={i} data-type={post.data.type} hidden={i !== 0} href={postUrl(post)}>
            <div class="b-cover" style={`background:${c.tint}`}>
              {post.data.cover ? <img src={post.data.cover} alt="" /> : <ThreadArt line={c.line} />}
            </div>
            <div style="padding:clamp(24px,3vw,40px);display:flex;flex-direction:column;gap:14px;justify-content:center">
              <span class="b-tag" style={`color:${c.label}`}>Featured · {post.data.type}</span>
              <h2 style="margin:0;font:800 clamp(28px,3.4vw,42px)/1.08 var(--font-display);letter-spacing:-0.03em;color:#14325A;text-wrap:balance">{post.data.title}</h2>
              <p style="margin:0;font:400 17px/1.6 var(--font-body);color:#3B4656;text-wrap:pretty">{post.data.excerpt}</p>
              <span style="font:500 14px/1.3 var(--font-body);color:#69727F">{fmtDate(post.data.date)} · {readTime(post.body)} min read</span>
              <span class="b-read">Read the post →</span>
            </div>
          </a>
        );
      })}
    </section>

    {showGrid && (
      <section class="b-wrap" style="padding-top:clamp(24px,3vw,40px)">
        <div class="b-grid">
          {posts.map((post, i) => <PostCard post={post} idx={i} hidden={i === 0} />)}
        </div>
      </section>
    )}

    <ClosingStart />
  </main>
</Base>

<script>
  import "../../scripts/blog.js";
</script>
