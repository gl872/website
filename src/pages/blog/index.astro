---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";

const TYPES = ["Company news", "Articles", "Practical guides"];

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const hasPosts = posts.length > 0;
---

<Base
  title="Blog | Krue"
  description="Updates on what we're building, and practical ideas for everyday life with chronic illness."
  path="/blog"
>
  <div class="page">
    <Header showAnnouncement={false} />
    <main>
      <section class="blog-hero">
        <div class="blog-hero__intro">
          <p class="eyebrow">Blog</p>
          <h1>News, articles, and practical guides.</h1>
        </div>
        <p class="blog-hero__lead">Updates on what we&rsquo;re building, and practical ideas for everyday life with chronic illness.</p>

        {!hasPosts && (
          <div role="status" class="blog-empty">
            <p class="blog-empty__big">Coming soon</p>
            <h2>We&rsquo;re working on our first posts.</h2>
            <p class="blog-empty__note">Check back soon for company news, articles, and practical guides.</p>
          </div>
        )}

        {hasPosts && (
          <>
            <div class="blog-controls">
              <div role="group" aria-label="Filter by type" class="blog-filters">
                <button type="button" class="pill blog-filter" data-filter="All" aria-pressed="true">All</button>
                {TYPES.map((t) => (
                  <button type="button" class="pill blog-filter" data-filter={t} aria-pressed="false">{t}</button>
                ))}
              </div>
              <div class="blog-search">
                <label for="blog-search" class="visually-hidden">Search the blog</label>
                <input id="blog-search" type="search" class="field" placeholder="Search by keyword" />
              </div>
            </div>

            <div id="blog-grid" class="blog-grid">
              {posts.map((post) => (
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  type={post.data.type}
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  cover={post.data.cover}
                  coverAlt={post.data.coverAlt}
                />
              ))}
            </div>

            <div id="blog-no-results" class="blog-no-results" hidden>
              <p class="blog-no-results__title">No posts match that yet.</p>
              <p class="blog-no-results__body">Try a different word, or see everything.</p>
              <button type="button" id="blog-clear" class="btn btn-secondary btn-md">Show all posts</button>
            </div>
          </>
        )}
      </section>
    </main>
    <Footer showBlogLink />
  </div>
</Base>

<style>
  .page { min-height: 100vh; background: var(--white); color: var(--navy-500); font-family: var(--font-body); display: flex; flex-direction: column; }
  main { flex: 1; }

  .blog-hero {
    max-width: 1220px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 96px) 24px clamp(72px, 9vw, 128px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .blog-hero__intro { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
  .blog-hero__intro h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--navy-500);
    text-wrap: balance;
  }
  .blog-hero__lead { margin: 0; max-width: none; font-size: 19px; line-height: 1.6; color: var(--grey-700); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* Empty state */
  .blog-empty {
    background: var(--grey-50);
    border-radius: 32px;
    padding: clamp(64px, 10vw, 140px) 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  .blog-empty__big { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(56px, 10vw, 128px); line-height: 0.95; letter-spacing: -0.045em; color: var(--sky-200); }
  .blog-empty h2 { margin: 8px 0 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2; letter-spacing: -0.02em; color: var(--grey-500); }
  .blog-empty__note { margin: 0; max-width: 46ch; font-size: 18px; line-height: 1.6; color: var(--grey-500); }

  /* Filters + search */
  .blog-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--grey-100);
  }
  .blog-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .blog-filter { padding: 8px 18px; }
  .blog-search { width: min(100%, 340px); }
  .blog-search input.field { height: var(--control-height-lg); }

  /* Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 28px 24px;
  }
  .blog-grid[hidden] { display: none; }

  .blog-no-results { padding: 48px 0; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .blog-no-results[hidden] { display: none; }
  .blog-no-results__title { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 24px; }
  .blog-no-results__body { margin: 0; font-size: 17px; color: var(--grey-700); }
</style>

<script>
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>(".blog-filter"));
  const search = document.getElementById("blog-search") as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".post-card"));
  const grid = document.getElementById("blog-grid");
  const noResults = document.getElementById("blog-no-results");
  const clearBtn = document.getElementById("blog-clear");

  let filter = "All";

  function apply() {
    const q = (search?.value ?? "").trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matchesFilter = filter === "All" || card.dataset.type === filter;
      const matchesQuery = !q || (card.dataset.search ?? "").includes(q);
      const show = matchesFilter && matchesQuery;
      card.hidden = !show;
      if (show) visible++;
    });
    if (grid) grid.hidden = visible === 0;
    if (noResults) noResults.hidden = visible !== 0;
  }

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      filter = pill.dataset.filter || "All";
      pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
      apply();
    });
  });

  search?.addEventListener("input", apply);

  clearBtn?.addEventListener("click", () => {
    filter = "All";
    if (search) search.value = "";
    pills.forEach((p) => p.setAttribute("aria-pressed", String(p.dataset.filter === "All")));
    apply();
  });

  apply();
</script>
