---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Privacy Policy | Krue"
  description="How Krue collects, uses, and protects your information."
  path="/privacy"
>
  <div class="page">
    <Header showAnnouncement={false} />
    <main>
      <section class="placeholder">
        <p class="eyebrow">Privacy Policy</p>
        <h1>This page is a placeholder.</h1>
        <p>Krue's real Privacy Policy needs to go here before launch — ideally reviewed by a lawyer, since this covers how personal and health information is collected, used, and protected. It's linked from the site footer and from the intake form's consent line.</p>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; background: var(--white); color: var(--navy-500); font-family: var(--font-body); }
  main { flex: 1; }
  .placeholder {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) 24px clamp(72px, 9vw, 128px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .placeholder h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--navy-500);
  }
  .placeholder p:last-child {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--grey-700);
  }
</style>
