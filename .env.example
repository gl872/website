# Google Apps Script web app URL that receives waitlist sign-ups (the address
# ending in /exec). The waitlist pop-up posts JSON to it and expects {"ok":true}.
# Set it in the host's environment variables too.
# Leave unset locally and the pop-up shows an error instead of sending anything.
PUBLIC_INTAKE_URL=

# Google Apps Script web app URL for "Get updates from Krue" sign-ups (investors,
# partners, press). Deploy krue-site-handoff/integrations/updates-sheet-apps-script.gs
# as a web app and paste its /exec URL here. It emails Grace on every sign-up.
# Leave unset and the updates pop-up shows an error instead of sending anything.
PUBLIC_UPDATES_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave unset to disable
# all analytics tracking and the cookie-consent banner entirely. Accepting the
# banner grants analytics only; ad signals are never granted.
PUBLIC_GTM_ID=

# Google Search Console verification token (the "content" value from the
# HTML-tag verification method). Leave unset to skip the verification tag.
PUBLIC_GSC_VERIFICATION=
