---
interface Props {
  slug: string;
  title: string;
  type: "Company news" | "Articles" | "Practical guides";
  excerpt: string;
  date: Date;
  cover?: string;
  coverAlt?: string;
}
const { slug, title, type, excerpt, date, cover, coverAlt } = Astro.props;

const TAG_BG: Record<string, string> = {
  "Company news": "var(--dandelion-100)",
  Articles: "var(--lavender-100)",
  "Practical guides": "var(--sage-100)",
};

const dateLabel = date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const searchText = `${title} ${excerpt} ${type}`.toLowerCase();
---

<article class="post-card" data-type={type} data-search={searchText}>
  <a href={`/blog/${slug}`} class="post-card__link">
    <div class="post-card__image" style={`background:${TAG_BG[type]}`}>
      {cover && <img src={cover} alt={coverAlt || ""} loading="lazy" />}
    </div>
    <div class="post-card__body">
      <div class="post-card__meta">
        <span class="post-card__tag" style={`background:${TAG_BG[type]}`}>{type}</span>
        <span class="post-card__date">{dateLabel}</span>
      </div>
      <h2>{title}</h2>
      <p>{excerpt}</p>
    </div>
  </a>
</article>

<style is:global>
  .post-card { display: flex; }
  .post-card__link {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    border-radius: 24px;
    transition: transform 220ms ease;
  }
  .post-card__link:hover { transform: translateY(-2px); }
  .post-card__link:focus-visible { box-shadow: 0 0 0 3px var(--sky-300); }
  .post-card__image {
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
  }
  .post-card__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-card__body { display: flex; flex-direction: column; gap: 8px; padding: 0 4px; }
  .post-card__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 14px; }
  .post-card__tag { color: var(--navy-800); border-radius: 999px; padding: 4px 12px; font-weight: 700; }
  .post-card__date { color: var(--grey-600); font-weight: 600; }
  .post-card__body h2 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; color: var(--navy-500); text-wrap: balance; }
  .post-card__body p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--grey-700); }
</style>
