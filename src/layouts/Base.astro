---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: "website" | "article";
}

const { title, description, path = "/", ogType = "website" } = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://krue.io");
const ogImage = new URL("/og-image.png", Astro.site ?? "https://krue.io");
const siteUrl = new URL("/", Astro.site ?? "https://krue.io");

const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Krue",
      url: siteUrl.toString(),
      logo: new URL("/assets/logos/krue-wordmark-navy.png", siteUrl).toString(),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "Krue",
      url: siteUrl.toString(),
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Krue" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Krue — support for daily life with chronic illness." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
