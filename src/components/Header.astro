---
const isBlog = Astro.url.pathname.startsWith("/blog");
---

<header class="site-header">
  <div class="site-header__row container">
    <a href="/" aria-label="Krue home" class="site-header__logo">
      <img src="/assets/logos/krue-wordmark-navy.png" alt="Krue" height="24" />
    </a>
    <nav aria-label="Main" class="site-header__nav">
      <a href="/#how">How it works</a>
      <a href="/#why">Why Krue</a>
      <a href="/blog" aria-current={isBlog ? "page" : undefined}>Blog</a>
    </nav>
    <a href="/#try" class="btn btn-primary btn-sm" data-try="header">Try Krue</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 247, 241, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-header__row {
    padding-block: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .site-header__logo {
    display: flex;
    flex: none;
  }
  .site-header__logo img {
    height: 24px;
    width: auto;
    max-width: none;
  }
  .site-header__nav {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    column-gap: 24px;
    row-gap: 40px;
    height: 44px;
    overflow: hidden;
    font: 600 15px/44px var(--font-display);
  }
  .site-header__nav a {
    color: #242B35;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__nav a:hover {
    color: #BC5230;
  }
  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: #F68B65;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .site-header .btn {
    flex: none;
    color: #FFFFFF;
  }
</style>
