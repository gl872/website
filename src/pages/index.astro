---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const burdens = [
  "There are questions to answer.",
  "Things to research.",
  "Recommendations to try.",
  "Appointments to prepare for.",
  "Referrals to follow up on.",
  "Symptoms and changes to remember.",
  "Resources to find.",
];

const placeholders = [
  "Finding strategies for managing my energy...",
  "Figuring out something my doctor recommended...",
  "Getting ready for my neurology appointment...",
  "Finding resources for work...",
  "Keeping track of everything I need to follow up on...",
  "I don't even know where to start...",
];
---

<Base
  title="Krue · Support for everything between appointments"
  description="Krue helps you find answers, make a plan, and stay on top of everything that happens between appointments, with a real person there to help along the way."
  path="/"
>
  <div id="top" class="page">
    <Header />

    <main>
      <!-- 1. Hero -->
      <section class="hero container">
        <h1>Chronic illness comes with a lot to figure out.</h1>
        <div class="hero__grid">
          <div class="hero__copy">
            <p class="hero__lead">Krue helps you find answers, make a plan, and stay on top of everything that happens between appointments — with a real person there to help along the way.</p>
            <div><a href="/#try" class="btn btn-primary btn-lg" data-try="hero">Try Krue →</a></div>
            <p class="hero__note">Currently piloting with a small group of people living with chronic illness.</p>
          </div>

          <div class="hero__visual" aria-hidden="true">
            <div class="plan-card plan-card--hero">
              <div class="plan-card__title">Your plan</div>
              <div class="eyebrow">THIS WEEK</div>
              <ul class="checklist">
                <li class="is-done"><span class="check"></span><span>Find compression options</span></li>
                <li><span class="check"></span><span>Write down questions for neurology</span></li>
                <li><span class="check"></span><span>Try pacing with a step tracker</span></li>
                <li><span class="check"></span><span>Follow up on rheumatology referral</span></li>
              </ul>
            </div>
            <div class="bubble bubble--grace bubble--hero">
              <div class="bubble__head"><span class="avatar">G</span><span>Grace from Krue</span></div>
              <p>“I know you got the compression stockings. Are you finding they’re helping?”</p>
            </div>
            <div class="hand" style="margin:10px 12px 0 auto;transform:rotate(-3deg)" aria-hidden="true">they remember and follow up</div>
          </div>
        </div>
      </section>

      <!-- 2. Problem -->
      <section class="problem container">
        <h2 class="h-xl" data-reveal>Your appointments are only part of managing your health.</h2>
        <ul class="burdens">
          {burdens.map((b) => (
            <li data-reveal><span class="ring"></span><span>{b}</span></li>
          ))}
        </ul>
        <p class="problem__para" data-reveal>And hours spent searching Google, Reddit, patient groups, and saved posts trying to figure out what might actually help.</p>
        <h2 class="h-xxl problem__left" data-reveal>Most of that gets left to you.</h2>
        <p class="problem__line" data-reveal>Krue is being built to make it less.</p>
      </section>

      <!-- 3. How Krue helps -->
      <section id="how" class="how">
        <div class="container how__inner">
          <div class="label-blue">HOW KRUE HELPS</div>
          <div class="timeline">
            <div class="step" data-reveal>
              <div class="step__rail">
                <span class="marker"></span>
                <span class="line line--solid"></span>
              </div>
              <div class="step__body">
                <h3>Figure it out.</h3>
                <p>Bring us what you’re trying to understand. We’ll help find credible information, resources, practical strategies, and useful next steps.</p>
              </div>
            </div>
            <div class="step" data-reveal>
              <div class="step__rail">
                <span class="marker"></span>
                <span class="line line--fade"></span>
              </div>
              <div class="step__body">
                <h3>Make a plan.</h3>
                <p>We’ll turn what matters to you into a simple plan — things to try, questions to ask, appointments to prepare for, resources to explore, and next steps.</p>
              </div>
            </div>
            <div class="step step--last" data-reveal>
              <div class="step__rail">
                <span class="marker marker--final"></span>
                <span class="line line--dashed"></span>
              </div>
              <div class="step__body step__body--last">
                <h3>Adapt as you go.</h3>
                <p>You won’t be left with a plan and sent on your way. A real person checks in, helps you follow through, and works through new questions with you as things change.</p>
                <div class="checkins">
                  <div class="checkin">
                    <span class="checkin__day">Monday</span>
                    <div class="bubble bubble--white">
                      <div class="bubble__head"><span class="avatar">G</span><span>Grace</span></div>
                      <p>“You were going to try moving your shower to the evening this week. How did that go?”</p>
                    </div>
                  </div>
                  <div class="checkin">
                    <span class="checkin__day">The following Tuesday</span>
                    <div class="bubble bubble--white">
                      <div class="bubble__head"><span class="avatar">G</span><span>Grace</span></div>
                      <p>“You mentioned your neurology appointment is Thursday. Want to go through the questions you’ve been saving?”</p>
                    </div>
                  </div>
                  <div class="hand hand--26" style="transform:rotate(-2deg);margin-left:12px" aria-hidden="true">same person, week after week</div>
                </div>
              </div>
            </div>
          </div>
          <h2 class="h-lg how__close" data-reveal>You don’t have to figure out every piece alone.</h2>
        </div>
      </section>

      <!-- 4. The experience -->
      <section class="experience container">
        <h2 class="h-xl exp__title">Start with whatever is on your mind.</h2>
        <p class="exp__sub">You don’t need to know what kind of help you need. Just tell us what’s going on.</p>

        <div class="exp__grid">
          <div class="thread">
            <div class="eyebrow">ONE THREAD, START TO FINISH</div>
            <span class="thread__on">A question</span>
            <span>Useful information</span>
            <span>A plan</span>
            <span>Something you try</span>
            <span>Someone following up</span>
          </div>

          <div class="convo">
            <div class="bubble bubble--user" style="align-self:flex-end;max-width:86%" data-reveal>My doctor told me to try compression for POTS but I have no idea what I’m actually supposed to buy.</div>
            <div class="bubble bubble--grace" style="align-self:flex-start;max-width:88%" data-reveal>
              <div class="bubble__head"><span class="avatar">G</span><span>Grace from Krue</span></div>
              <p>I can help you sort through the different types and what to consider. Did they mention a compression level or how high it should go?</p>
            </div>
            <div class="plan-card plan-card--convo" data-reveal>
              <div class="eyebrow">ADDED TO YOUR PLAN</div>
              <ul class="checklist checklist--tight">
                <li class="is-done"><span class="check"></span><span>Understand compression options</span></li>
                <li class="is-done"><span class="check"></span><span>Confirm compression level with doctor</span></li>
                <li><span class="check"></span><span>Choose an option to try</span></li>
              </ul>
            </div>
            <div class="divider" data-reveal><span></span><span>A week later</span><span></span></div>
            <div class="bubble bubble--grace" style="align-self:flex-start;max-width:88%" data-reveal>
              <div class="bubble__head"><span class="avatar">G</span><span>Grace from Krue</span></div>
              <p>You were looking into compression last week. Did you end up trying anything?</p>
            </div>
            <div class="bubble bubble--user" style="align-self:flex-end;max-width:80%" data-reveal>I ordered a pair of knee-highs. Still getting used to them.</div>
            <div class="hand" style="align-self:flex-end;transform:rotate(-2deg);margin-right:8px" aria-hidden="true">and it stays on the plan until it’s sorted</div>
          </div>
        </div>

        <div class="examples">
          <div class="example" data-reveal>
            <div class="eyebrow eyebrow--grey">PREPARING FOR A SPECIALIST</div>
            <div class="bubble bubble--user bubble--sm" style="align-self:flex-end;max-width:88%">I see rheumatology in two weeks and I always forget what I wanted to ask.</div>
            <div class="bubble bubble--grace bubble--sm" style="align-self:flex-start;max-width:90%">Let’s pull together what you’ve been saving. Want to add the joint pain you mentioned last week?</div>
            <div class="example__row"><span class="check"></span><span>Bring question list to rheumatology</span></div>
          </div>
          <div class="example" data-reveal>
            <div class="eyebrow eyebrow--grey">KNOWING WHETHER SOMETHING HELPED</div>
            <div class="bubble bubble--user bubble--sm" style="align-self:flex-end;max-width:88%">I’ve been pacing my energy for a couple of weeks. I honestly can’t tell if it’s working.</div>
            <div class="bubble bubble--grace bubble--sm" style="align-self:flex-start;max-width:90%">Want to jot down a quick energy check each evening? We can look at it together on Friday.</div>
            <div class="example__row"><span class="check"></span><span>Evening energy check, Monday to Friday</span></div>
          </div>
        </div>
      </section>

      <!-- 5. Founder -->
      <section id="why" class="founder">
        <div class="container founder__grid">
          <img class="founder__photo" src="/assets/photos/founder-grace.jpg" alt="Grace, founder of Krue" width="240" height="300" loading="lazy" />
          <div class="founder__text">
            <h2>I started Krue because I’ve lived this.</h2>
            <blockquote>
              <p>“After I suddenly became sick with POTS, I learned how much of managing chronic illness happens outside the doctor’s office.</p>
              <p>I had to research constantly, find the right people, keep track of recommendations, prepare for appointments, try different strategies, and figure out how to live my life around a body that had changed.</p>
              <p>Over time, I built my own system for managing it.</p>
              <p class="strong">Krue is my attempt to give other people the support I wish I’d had.”</p>
            </blockquote>
            <div class="founder__sig">— Grace, Founder</div>
            <p class="founder__note">Built from lived experience and 50+ hours talking with people navigating chronic illness.</p>
          </div>
        </div>
      </section>

      <!-- 6. Try Krue -->
      <section id="try" class="try">
        <div class="container try__inner">
          <h2 class="h-xxl">Give yourself less to manage.</h2>
          <div class="try__body">
            <p>Krue is currently working with a small group of people with chronic illness to build a better way to manage everything that happens between appointments.</p>
            <p>For the current pilot, you’ll work directly with Grace to build your plan and have support along the way. Participation is free.</p>
          </div>

          <div id="try-intro" class="try__intro">
            <a href="/#try" class="btn btn-primary btn-lg" data-try="try_section">I’d like to try Krue →</a>
          </div>

          <form id="intake" class="card" hidden novalidate data-placeholders={JSON.stringify(placeholders)}>
            <label for="help" class="card__q">What could you use help with right now?</label>
            <textarea id="help" name="help" class="field" rows="5" placeholder={placeholders[0]}></textarea>
            <div class="form-grid">
              <div class="fld">
                <label for="name">Name</label>
                <input id="name" name="name" class="field" type="text" autocomplete="given-name" />
              </div>
              <div class="fld">
                <label for="email">Email</label>
                <input id="email" name="email" class="field" type="email" required autocomplete="email" aria-describedby="email-error" />
                <p id="email-error" class="fld__error" role="alert" hidden>Enter an email in the format name@example.com.</p>
              </div>
            </div>
            <div class="fld">
              <label for="conditions">Condition(s)</label>
              <input id="conditions" name="conditions" class="field" type="text" placeholder="Whatever you’d like to share" aria-describedby="conditions-hint" />
              <p id="conditions-hint" class="fld__hint">Optional. You don’t need a diagnosis to join.</p>
            </div>
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="consent">By submitting, you agree to our <a href="/privacy">Privacy Policy</a>.</p>
            <p id="form-error" class="form-error" role="alert" hidden>Something went wrong. Please try again.</p>
            <div><button type="submit" id="submit-btn" class="btn btn-primary btn-lg">I’d like to try Krue →</button></div>
          </form>

          <div id="thanks" class="card card--thanks" hidden>
            <h3 id="thanks-title" tabindex="-1">Thanks. Grace will be in touch by email.</h3>
            <p class="thanks__lead">Here’s what the pilot looks like:</p>
            <ul class="dots">
              <li><span></span><span>A one-hour kickoff conversation about what’s going on and what you want help with</span></li>
              <li><span></span><span>Two weeks working with Grace on your plan, with messaging whenever something comes up</span></li>
              <li><span></span><span>A 30-minute debrief at the end and a short feedback survey</span></li>
            </ul>
            <p class="thanks__free">It’s free.</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>

<style>
  .page { min-height: 100vh; background: var(--surface-cream); color: #3A4350; font-family: var(--font-body); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 700; color: #242B35; margin: 0; text-wrap: balance; }
  p { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; }

  .h-xl { font-size: clamp(36px, 6vw, 76px); line-height: 1.04; letter-spacing: -0.03em; }
  .h-lg { font-size: clamp(38px, 6vw, 76px); line-height: 1.04; letter-spacing: -0.03em; max-width: 15ch; }
  .h-xxl { font-size: clamp(44px, 8vw, 104px); line-height: 1; letter-spacing: -0.035em; max-width: 12ch; }

  .eyebrow { font: 700 11px/1.2 var(--font-display); letter-spacing: 0.09em; color: #B34D2C; text-transform: none; }
  .eyebrow--grey { color: #525C6B; margin-bottom: 6px; }
  .hand--26 { font-size: 26px; }

  /* shared pieces */
  .avatar { width: 28px; height: 28px; border-radius: 50%; background: #DAF1FD; color: #1D4878; font: 700 12px/1 var(--font-display); display: inline-grid; place-items: center; flex: none; }
  .bubble { border-radius: 22px 22px 22px 6px; padding: 14px 18px 16px; font: 400 17px/1.45 var(--font-body); color: #242B35; }
  .bubble p { margin: 8px 0 0; }
  .bubble__head { display: flex; align-items: center; gap: 8px; font: 600 14px/1.2 var(--font-display); color: #242B35; }
  .bubble--grace { background: #DAF1FD; }
  .bubble--white { background: #FFFFFF; border-radius: 20px 20px 20px 6px; max-width: 92%; }
  .bubble--user { background: #242B35; color: #FFFFFF; border-radius: 22px 22px 6px 22px; padding: 14px 18px; }
  .bubble--sm { font-size: 16px; padding: 12px 16px; border-radius: 20px 20px 20px 6px; }
  .bubble--sm.bubble--user { border-radius: 20px 20px 6px 20px; }

  .plan-card { background: #FFFFFF; }
  .checklist { display: flex; flex-direction: column; gap: 14px; margin-top: 14px; font: 400 17px/1.35 var(--font-body); color: #242B35; }
  .checklist--tight { gap: 12px; }
  .checklist li { display: flex; gap: 12px; align-items: center; }
  .check { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid #C3CAD6; box-sizing: border-box; flex: none; display: grid; place-items: center; }
  .is-done { color: #5F6B7D; }
  .is-done .check { background: #F68B65; border-color: #F68B65; }
  .is-done .check::after { content: ""; width: 5px; height: 9px; border: solid #FFFFFF; border-width: 0 2px 2px 0; transform: translateY(-1px) rotate(45deg); }
  .is-done span:last-child { text-decoration: line-through; text-decoration-color: #C3CAD6; }
  .ring { width: clamp(18px, 2.2vw, 28px); height: clamp(18px, 2.2vw, 28px); border-radius: 50%; border: 2px solid #C3CAD6; box-sizing: border-box; flex: none; }

  /* 1. Hero */
  .hero { padding-top: clamp(48px, 9vw, 120px); padding-bottom: clamp(72px, 10vw, 140px); }
  .hero h1 { font-size: clamp(44px, 8.4vw, 104px); line-height: 1; letter-spacing: -0.035em; max-width: 13ch; }
  .hero__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: clamp(48px, 6vw, 96px); align-items: end; margin-top: clamp(36px, 5vw, 64px); }
  .hero__copy { display: flex; flex-direction: column; gap: 28px; max-width: 34rem; }
  .hero__lead { font-size: clamp(19px, 1.7vw, 22px); line-height: 1.5; color: #3A4350; text-wrap: pretty; }
  .hero__note { font: italic 400 15px/1.5 var(--font-body); color: #5F6B7D; }
  .hero__visual { position: relative; max-width: 460px; width: 100%; justify-self: end; }
  .plan-card--hero { border-radius: 24px; padding: 28px 28px 32px; box-shadow: 0 1px 2px rgba(12,30,51,.04), 0 12px 32px rgba(12,30,51,.06); transform: rotate(-1.2deg); }
  .plan-card__title { font: 700 24px/1.2 var(--font-display); color: #242B35; letter-spacing: -0.01em; margin-bottom: 20px; }
  .bubble--hero { position: relative; margin: -22px -8px 0 auto; width: min(88%, 360px); border-radius: 22px 22px 6px 22px; padding: 16px 18px 18px; box-shadow: 0 10px 28px rgba(12,30,51,.08); }
  .bubble--hero .bubble__head { gap: 10px; }
  .bubble--hero p { margin-top: 10px; }

  /* 2. Problem */
  .problem { padding-top: clamp(56px, 9vw, 120px); padding-bottom: clamp(96px, 14vw, 180px); }
  .problem .h-xl { max-width: 16ch; }
  .burdens { margin-top: clamp(56px, 8vw, 104px); display: flex; flex-direction: column; gap: clamp(18px, 2.4vw, 28px); font: 600 clamp(24px, 3.6vw, 44px)/1.15 var(--font-display); letter-spacing: -0.015em; color: #525C6B; }
  .burdens li { display: flex; gap: clamp(14px, 2vw, 24px); align-items: center; }
  .problem__para { margin-top: clamp(40px, 6vw, 72px); max-width: 34ch; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.45; color: #3A4350; text-wrap: pretty; }
  .problem__left { margin-top: clamp(96px, 14vw, 180px); }
  .problem__line { margin-top: clamp(24px, 3vw, 36px); font: 600 clamp(22px, 2.6vw, 32px)/1.25 var(--font-display); letter-spacing: -0.01em; color: #BC5230; }

  /* 3. How */
  .how { background: #DAF1FD; scroll-margin-top: 60px; }
  .how__inner { padding-block: clamp(80px, 11vw, 150px); }
  .label-blue { font: 700 12px/1.2 var(--font-display); letter-spacing: 0.09em; color: #235592; }
  .timeline { margin-top: clamp(40px, 6vw, 72px); display: flex; flex-direction: column; max-width: 900px; }
  .step { display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: clamp(20px, 3vw, 40px); }
  .step__rail { display: flex; flex-direction: column; align-items: center; }
  .marker { width: 18px; height: 18px; border-radius: 50%; background: #FFFFFF; border: 2px solid #235592; box-sizing: border-box; margin-top: clamp(12px, 1.6vw, 20px); flex: none; }
  .marker--final { width: 26px; height: 26px; border: 0; background: #F68B65; margin-top: clamp(10px, 1.6vw, 20px); box-shadow: 0 0 0 6px rgba(246,139,101,.22); }
  .line { flex: 1; width: 2px; margin-top: 8px; }
  .line--solid { background: #9BDBF5; }
  .line--fade { background: linear-gradient(#9BDBF5, #F68B65); }
  .line--dashed { background: repeating-linear-gradient(#F68B65 0 6px, transparent 6px 12px); margin-top: 10px; }
  .step__body { padding-bottom: clamp(48px, 6vw, 80px); }
  .step__body--last { padding-bottom: 0; }
  .step h3 { font-size: clamp(34px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.03em; }
  .step p { margin-top: 18px; max-width: 40ch; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: #3A4350; text-wrap: pretty; }
  .step--last h3 { font-size: clamp(40px, 6.4vw, 80px); line-height: 1.02; letter-spacing: -0.035em; }
  .step--last > .step__body > p { max-width: 42ch; font-size: clamp(19px, 1.8vw, 23px); line-height: 1.5; color: #242B35; }
  .checkins { margin-top: clamp(32px, 4vw, 48px); display: flex; flex-direction: column; gap: 20px; max-width: 520px; }
  .checkin { display: flex; flex-direction: column; gap: 8px; }
  .checkin__day { font: 600 13px/1.2 var(--font-body); color: #525C6B; }
  .step .bubble p { max-width: none; margin: 8px 0 0; font: 400 17px/1.45 var(--font-body); color: #242B35; }
  .how__close { margin-top: clamp(96px, 12vw, 160px); }

  /* 4. Experience */
  .experience { padding-block: clamp(80px, 11vw, 150px); }
  .exp__title { max-width: 14ch; }
  .exp__sub { margin-top: 24px; max-width: 36ch; font-size: clamp(19px, 1.8vw, 22px); line-height: 1.5; color: #3A4350; text-wrap: pretty; }
  .exp__grid { margin-top: clamp(56px, 8vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .thread { display: flex; flex-direction: column; gap: 10px; font: 600 15px/1.3 var(--font-display); color: #5F6B7D; max-width: 300px; }
  .thread .eyebrow { margin-bottom: 6px; }
  .thread__on { color: #242B35; }
  .convo { display: flex; flex-direction: column; gap: 16px; max-width: 560px; width: 100%; grid-column: span 2 / auto; }
  .plan-card--convo { margin: 14px 0; border-radius: 20px; padding: 20px 22px 22px; box-shadow: 0 1px 2px rgba(12,30,51,.04), 0 8px 24px rgba(12,30,51,.05); }
  .divider { display: flex; align-items: center; gap: 14px; font: 600 13px/1.2 var(--font-body); color: #5F6B7D; }
  .divider span:first-child, .divider span:last-child { flex: 1; height: 1px; background: #E4DDD2; }
  .examples { margin-top: clamp(88px, 12vw, 150px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: clamp(48px, 6vw, 80px); }
  .example { border-top: 1px solid #E4DDD2; padding-top: 28px; display: flex; flex-direction: column; gap: 14px; }
  .example__row { display: flex; gap: 10px; align-items: center; font: 400 16px/1.35 var(--font-body); color: #242B35; margin-top: 6px; }
  .example__row .check { width: 18px; height: 18px; }

  /* 5. Founder */
  .founder { border-top: 1px solid #E4DDD2; scroll-margin-top: 60px; }
  .founder__grid { padding-block: clamp(80px, 11vw, 150px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: clamp(36px, 5vw, 72px); align-items: start; }
  .founder__photo { width: min(100%, 240px); height: 300px; border-radius: 20px; object-fit: cover; display: block; }
  .founder__text { grid-column: span 2 / auto; max-width: 640px; display: flex; flex-direction: column; }
  .founder h2 { font-size: clamp(34px, 5vw, 60px); line-height: 1.06; letter-spacing: -0.03em; }
  .founder blockquote { margin: 32px 0 0; display: flex; flex-direction: column; gap: 18px; font-size: clamp(18px, 1.6vw, 20px); line-height: 1.6; color: #3A4350; text-wrap: pretty; }
  .founder .strong { color: #242B35; font-weight: 600; }
  .founder__sig { margin-top: 24px; font: 600 16px/1.3 var(--font-display); color: #242B35; }
  .founder__note { margin-top: 40px; padding-top: 20px; border-top: 1px solid #E4DDD2; font-size: 15px; line-height: 1.5; color: #525C6B; }

  /* 6. Try */
  .try { background: #FEEBE4; scroll-margin-top: 60px; }
  .try__inner { padding-block: clamp(80px, 11vw, 150px); }
  .try__body { margin-top: 32px; max-width: 40rem; display: flex; flex-direction: column; gap: 16px; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; color: #3A4350; text-wrap: pretty; }
  .try__intro { margin-top: 40px; display: flex; }
  .card { margin-top: clamp(56px, 7vw, 88px); max-width: 720px; background: #FFFFFF; border-radius: 28px; padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 24px; box-shadow: 0 12px 40px rgba(12,30,51,.06); scroll-margin-top: 90px; }
  .card[hidden], .try__intro[hidden] { display: none; }
  .card--thanks { display: block; box-shadow: none; }
  .card__q { font: 700 clamp(28px, 4vw, 44px)/1.1 var(--font-display); letter-spacing: -0.025em; color: #242B35; }
  .card .field { font: 400 16px var(--font-body); border: 1.5px solid #C3CAD6; border-radius: 14px; }
  .card input.field { height: 44px; padding: 0 16px; }
  .card textarea.field { padding: 12px 16px; }
  .card .field.is-invalid { border-color: #E06B42; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 20px; }
  .fld { display: flex; flex-direction: column; gap: 8px; }
  .fld label { font: 600 14px/1.3 var(--font-body); color: #242B35; }
  .fld__hint { font-size: 13px; line-height: 1.4; color: #5F6B7D; }
  .fld__error, .form-error { font-size: 13px; line-height: 1.4; color: #BC5230; }
  .form-error { font-size: 15px; }
  .consent { font-size: 14px; line-height: 1.5; color: #525C6B; }
  .consent a { color: #525C6B; text-decoration: underline; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .card--thanks h3 { font-size: clamp(28px, 4vw, 44px); line-height: 1.1; letter-spacing: -0.025em; outline: none; }
  .thanks__lead { margin-top: 20px; font-size: 18px; line-height: 1.55; color: #3A4350; }
  .dots { margin-top: 16px; display: flex; flex-direction: column; gap: 12px; font-size: 18px; line-height: 1.45; color: #242B35; }
  .dots li { display: flex; gap: 12px; align-items: baseline; }
  .dots li span:first-child { width: 8px; height: 8px; border-radius: 50%; background: #F68B65; flex: none; transform: translateY(-2px); }
  .thanks__free { margin-top: 24px; font-size: 16px; line-height: 1.5; color: #525C6B; }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const form = document.getElementById("intake") as HTMLFormElement;
  const intro = document.getElementById("try-intro") as HTMLElement;
  const thanks = document.getElementById("thanks") as HTMLElement;
  const thanksTitle = document.getElementById("thanks-title") as HTMLElement;
  const helpEl = document.getElementById("help") as HTMLTextAreaElement;
  const nameEl = document.getElementById("name") as HTMLInputElement;
  const emailEl = document.getElementById("email") as HTMLInputElement;
  const condEl = document.getElementById("conditions") as HTMLInputElement;
  const emailErr = document.getElementById("email-error") as HTMLElement;
  const formErr = document.getElementById("form-error") as HTMLElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  let submitted = false;

  // Analytics events for Google Tag Manager. Names and button locations only;
  // never include anything the visitor typed.
  function track(event: string, params: Record<string, string> = {}) {
    const w = window as unknown as { dataLayer?: unknown[] };
    (w.dataLayer = w.dataLayer || []).push({ event, ...params });
  }

  function scrollToId(id: string) {
    setTimeout(() => {
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 90, behavior: reduceMotion ? "auto" : "smooth" });
    }, 40);
  }

  function openForm() {
    if (submitted) return scrollToId("thanks");
    intro.hidden = true;
    form.hidden = false;
    scrollToId("intake");
  }

  document.querySelectorAll<HTMLElement>("[data-try]").forEach((el) =>
    el.addEventListener("click", (e) => {
      e.preventDefault();
      track("try_krue_click", { button_location: el.dataset.try || "unknown" });
      history.replaceState(null, "", "/#try");
      openForm();
    })
  );
  if (location.hash === "#try" || location.hash === "#start") openForm();

  // Rotating placeholder
  const placeholders: string[] = JSON.parse(form.dataset.placeholders || "[]");
  if (!reduceMotion && placeholders.length > 1) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % placeholders.length;
      helpEl.placeholder = placeholders[i];
    }, 3200);
  }

  let started = false;
  form.addEventListener("input", () => {
    if (started) return;
    started = true;
    track("form_start");
  });

  // Validation
  function validateEmail() {
    const ok = EMAIL_RE.test(emailEl.value.trim());
    emailEl.classList.toggle("is-invalid", !ok);
    emailEl.setAttribute("aria-invalid", String(!ok));
    emailErr.hidden = ok;
    return ok;
  }
  emailEl.addEventListener("blur", validateEmail);
  emailEl.addEventListener("input", () => { if (!emailErr.hidden) validateEmail(); });

  // Sends the sign-up to the Google Sheet script. Never log help/conditions.
  async function sendPilot(payload: Record<string, string>): Promise<boolean> {
    const url = import.meta.env.PUBLIC_INTAKE_URL;
    if (!url) {
      console.warn("PUBLIC_INTAKE_URL is not set; sign-up was not sent.");
      return false;
    }
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify(payload),
    });
    const json = await res.json();
    return json?.ok === true;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    formErr.hidden = true;
    if (!validateEmail()) { emailEl.focus(); return; }
    const data = new FormData(form);
    const payload = {
      submittedAt: new Date().toISOString(),
      form: "pilot",
      help: helpEl.value,
      firstName: nameEl.value.trim(),
      email: emailEl.value.trim(),
      conditions: condEl.value,
      source: "homepage-v2",
      website: String(data.get("website") || ""),
    };
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending…";
    let ok = false;
    try { ok = await sendPilot(payload); } catch { ok = false; }
    if (!ok) {
      submitBtn.disabled = false;
      submitBtn.textContent = "I’d like to try Krue →";
      formErr.hidden = false;
      track("form_submit_error");
      return;
    }
    submitted = true;
    track("form_submit_success");
    const n = payload.firstName;
    thanksTitle.textContent = n ? `Thanks, ${n}. Grace will be in touch by email.` : "Thanks. Grace will be in touch by email.";
    form.hidden = true;
    thanks.hidden = false;
    scrollToId("thanks");
    thanksTitle.focus({ preventScroll: true });
  });

  // Scroll reveal: hidden state is applied only from JS so no-JS/crawlers see everything.
  if (!reduceMotion && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const t = en.target as HTMLElement;
      t.style.opacity = "1";
      t.style.transform = "none";
      io.unobserve(t);
    }), { rootMargin: "0px 0px -10% 0px" });
    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight * 0.9) return;
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
      el.style.transition = "opacity 700ms cubic-bezier(.2,.7,.2,1), transform 700ms cubic-bezier(.2,.7,.2,1)";
      io.observe(el);
    });
  }
</script>
