---
// Grid card for a blog post (blog list grid and "More from the blog").
import ThreadArt from "./ThreadArt.astro";
import { CATEGORY, fmtDate, postUrl, readTime, type Post } from "../../lib/blog";

interface Props {
  post: Post;
  idx?: number;
  hidden?: boolean;
}
const { post, idx, hidden = false } = Astro.props;
const c = CATEGORY[post.data.type];
---

<a class="b-card" href={postUrl(post)} data-idx={idx} data-type={idx === undefined ? undefined : post.data.type} hidden={hidden}>
  <div class="b-cover" style={`background:${c.tint}`}>
    {post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" /> : <ThreadArt line={c.line} />}
  </div>
  <div style="padding:22px 22px 26px;display:flex;flex-direction:column;gap:10px;flex:1">
    <span class="b-tag" style={`color:${c.label}`}>{post.data.type}</span>
    <h3 style="margin:0;font:700 21px/1.25 var(--font-display);letter-spacing:-0.015em;color:#14325A;text-wrap:balance">{post.data.title}</h3>
    <p style="margin:0;font:400 15.5px/1.55 var(--font-body);color:#3B4656;text-wrap:pretty;flex:1">{post.data.excerpt}</p>
    <span style="font:500 13.5px/1.3 var(--font-body);color:#69727F">{fmtDate(post.data.date)} · {readTime(post.body)} min read</span>
  </div>
</a>
