# Google Apps Script web app URL for the intake form (see design_handoff_krue_site/README.md
# "Google Apps Script (intake receiver)"). Leave unset locally to just log submissions
# to the console instead of sending them anywhere.
PUBLIC_INTAKE_URL=

# Address of the separate intake app that "Get started" buttons link to.
# Leave unset to send visitors to the "coming soon" page instead.
PUBLIC_APP_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave unset to disable
# all analytics/marketing tracking and the cookie-consent banner entirely.
PUBLIC_GTM_ID=

# Google Search Console verification token (the "content" value from the
# HTML-tag verification method). Leave unset to skip the verification tag.
PUBLIC_GSC_VERIFICATION=
