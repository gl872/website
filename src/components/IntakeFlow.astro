---
// Multi-step intake form embedded in the homepage hero (#start).
// See design_handoff_krue_site/README.md "Intake flow" for the full spec.
---

<div id="intake-card" class="intake-card">
  <input type="text" id="intake-website" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div id="intake-body"></div>
</div>

<style is:global>
  /* IntakeFlow's body is rendered client-side via innerHTML, so these rules must
     stay unscoped — Astro's per-element scoping attribute never reaches nodes
     inserted after the initial render. */
  .intake-card {
    box-sizing: border-box;
    width: 100%;
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs), 0 18px 48px rgba(12, 30, 51, 0.08);
    padding: clamp(20px, 4vw, 36px);
    font-family: var(--font-body);
    color: var(--navy-500);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  #intake-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Step header */
  .intake-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }
  .intake-back {
    min-height: 44px;
    padding: 0 14px 0 8px;
    margin-left: -8px;
    border: 0;
    background: transparent;
    border-radius: 999px;
    color: var(--navy-500);
    font: 700 15px var(--font-body);
    cursor: pointer;
  }
  .intake-back:hover {
    background: var(--navy-50);
  }
  .intake-step-count {
    font-size: 14px;
    font-weight: 700;
    color: var(--grey-600);
  }

  .intake-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy-500);
    text-wrap: balance;
  }
  .intake-heading p {
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--grey-700);
  }

  .intake-section {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .intake-section--profile {
    gap: 22px;
  }
  .intake-section--review {
    gap: 12px;
  }
  .conditions-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .intake-field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .intake-info-box {
    font-size: 15px;
    line-height: 1.5;
    color: var(--navy-700);
    background: var(--sky-100);
    border-radius: var(--radius-md);
    padding: 10px 14px;
  }
  .intake-error {
    font-size: 15px;
    line-height: 1.45;
    font-weight: 600;
    color: var(--burnt-sun-600);
  }
  .intake-contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 14px;
  }
  .intake-span-2 {
    grid-column: 1 / -1;
  }
  .intake-phone-grid {
    display: grid;
    grid-template-columns: minmax(120px, 160px) minmax(0, 1fr);
    gap: 10px;
  }
  .conditions-group__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cond-desc {
    font-size: 15px;
    line-height: 1.45;
    color: var(--grey-700);
  }
  .cond-add-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    max-width: 520px;
  }
  .cond-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 520px;
  }
  .cond-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 4px 6px 4px 16px;
    border-radius: 999px;
    background: var(--navy-500);
    color: #FFFFFF;
    font: 600 15px var(--font-body);
  }
  .cond-chip button {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 0;
    background: #FFFFFF;
    color: var(--navy-500);
    font: 700 18px/1 var(--font-body);
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .review-card {
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .review-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .review-card__head strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--navy-500);
  }
  .review-edit {
    min-height: 44px;
    padding: 0 14px;
    margin-right: -8px;
    border: 0;
    background: transparent;
    border-radius: 999px;
    color: var(--navy-500);
    font: 700 15px var(--font-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .review-edit:hover {
    background: var(--navy-50);
  }
  .review-row,
  .summary-row {
    display: grid;
    grid-template-columns: minmax(96px, max-content) minmax(0, 1fr);
    gap: 12px;
    font-size: 15px;
    line-height: 1.45;
  }
  .summary-row {
    grid-template-columns: minmax(110px, max-content) minmax(0, 1fr);
  }
  .review-row span:first-child,
  .summary-row span:first-child {
    font-weight: 700;
    color: var(--navy-500);
  }
  .review-row span:last-child {
    color: var(--grey-700);
    overflow-wrap: anywhere;
  }
  .summary-row span:last-child {
    color: var(--grey-700);
  }
  .consent-line {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--grey-600);
  }

  .intake-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 4px;
  }

  .done-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 8px 0;
  }
  .done-wrap h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(26px, 3.2vw, 34px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--navy-500);
    text-wrap: balance;
  }
  .done-wrap p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--grey-700);
    max-width: 58ch;
  }
  .summary-box {
    background: var(--grey-50);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .summary-box__title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--grey-600);
  }
  .restart-btn {
    border: 1.5px solid var(--sky-400) !important;
  }
</style>

<script>
  const NOT_SURE = 'I’m not sure where to start';
  const NEEDS = ['Managing my energy', 'Taking care of myself', 'Keeping up with things at home', 'Making work or school more manageable', 'Moving in a way that works for me', 'Getting out and doing more', 'Handling brain fog and staying organized'];
  const CONDS = ['POTS or dysautonomia', 'Long COVID', 'ME/CFS', 'EDS or hypermobility', 'Fibromyalgia or chronic pain', 'Something else', 'Not diagnosed yet', 'Prefer not to say'];
  const STATES = ['Alabama', 'Alaska', 'Arizona', 'Arkansas', 'California', 'Colorado', 'Connecticut', 'Delaware', 'District of Columbia', 'Florida', 'Georgia', 'Hawaii', 'Idaho', 'Illinois', 'Indiana', 'Iowa', 'Kansas', 'Kentucky', 'Louisiana', 'Maine', 'Maryland', 'Massachusetts', 'Michigan', 'Minnesota', 'Mississippi', 'Missouri', 'Montana', 'Nebraska', 'Nevada', 'New Hampshire', 'New Jersey', 'New Mexico', 'New York', 'North Carolina', 'North Dakota', 'Ohio', 'Oklahoma', 'Oregon', 'Pennsylvania', 'Rhode Island', 'South Carolina', 'South Dakota', 'Tennessee', 'Texas', 'Utah', 'Vermont', 'Virginia', 'Washington', 'West Virginia', 'Wisconsin', 'Wyoming', 'Outside the US'];
  const CC = [['+1', '+1 US/CA'], ['+44', '+44 UK'], ['+61', '+61 AU'], ['+64', '+64 NZ'], ['+353', '+353 IE'], ['+49', '+49 DE'], ['+33', '+33 FR'], ['+91', '+91 IN']];
  const STEPS = ['need', 'profile', 'contact', 'review'];
  const INIT = () => ({ idx: 0, reached: false, done: false, submitting: false, submitError: false, needs: [], notes: '', first: '', last: '', email: '', emailTouched: false, cc: '+1', phone: '', st: '', conds: [], condText: '', custom: [], other: '' });

  const fmtUS = (v) => {
    const d = v.replace(/\D/g, '').replace(/^1(?=\d{10})/, '').slice(0, 10);
    if (d.length < 4) return d.length ? '(' + d : '';
    if (d.length < 7) return '(' + d.slice(0, 3) + ') ' + d.slice(3);
    return '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6);
  };
  const emailOk = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
  const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function init(root) {
    let state = INIT();
    const body = root.querySelector('#intake-body');
    const websiteEl = root.querySelector('#intake-website');

    function pillHtml(label, selected, action, dataAttr, accent) {
      const cls = 'pill' + (accent ? ' pill-accent' : '');
      return `<button type="button" class="${cls}" aria-pressed="${selected}" data-action="${action}" data-value="${esc(label)}">${esc(label)}</button>`;
    }

    function titleFor(id) {
      switch (id) {
        case 'need': return { title: 'What do you need help with?', sub: '' };
        case 'profile': return { title: 'Help us connect you with the right person.', sub: '' };
        case 'contact': return { title: 'How can we contact you?', sub: 'We’ll follow up when we’ve found an expert who can help.' };
        case 'review': return { title: 'Review and submit', sub: 'Check that everything looks right. You can edit any section before you submit.' };
      }
    }

    function ctaFor(id) {
      if (id === 'contact') return 'Review';
      if (id === 'review') return 'Submit';
      return 'Continue';
    }

    function validFor(id) {
      if (id === 'need') return state.needs.length > 0 || state.notes.trim().length > 0;
      if (id === 'profile') return !!state.st;
      if (id === 'contact') {
        const pd = state.phone.replace(/\D/g, '').length;
        return !!state.first.trim() && !!state.last.trim() && emailOk(state.email) && (pd === 0 || pd >= 7);
      }
      return true;
    }

    function conditionsText() {
      return [...state.conds.filter((c) => c !== 'Something else'), ...(state.conds.includes('Something else') ? state.custom : [])].join(', ');
    }

    function renderNeedStep() {
      const pills = NEEDS.map((n) => pillHtml(n, state.needs.includes(n), 'pick-need')).join('') +
        pillHtml(NOT_SURE, state.needs.includes(NOT_SURE), 'pick-notsure', null, true);
      return `
        <div class="intake-section">
          <div role="group" aria-label="What do you need help with?" class="pill-group">${pills}</div>
          <div class="intake-field-group">
            <label for="intake-notes" class="field-label">Anything you’d like to add?</label>
            <textarea id="intake-notes" data-bind="notes" rows="3" class="field" placeholder="Share what’s hard in your day or where you could use help.">${esc(state.notes)}</textarea>
          </div>
        </div>`;
    }

    function renderProfileStep() {
      const condPills = CONDS.map((c) => pillHtml(c, state.conds.includes(c), 'pick-cond')).join('');
      const stateOptions = '<option value="">Select your state</option>' + STATES.map((s) => `<option value="${esc(s)}"${state.st === s ? ' selected' : ''}>${esc(s)}</option>`).join('');
      const showCondText = state.conds.includes('Something else');
      const chips = state.custom.map((c) => `<span role="listitem" class="cond-chip">${esc(c)}<button type="button" data-action="remove-cond" data-value="${esc(c)}" aria-label="Remove ${esc(c)}">×</button></span>`).join('');
      return `
        <div class="intake-section intake-section--profile">
          <div class="intake-field-group">
            <label for="intake-state" class="field-label">State you live in<span aria-hidden="true" class="required-mark">*</span></label>
            <span class="intake-info-box">We use this to connect you with an occupational therapist who can practice where you are since they are licensed state by state.</span>
            <div style="max-width:420px">
              <div class="select-wrap"><select id="intake-state" data-bind="st" class="field">${stateOptions}</select></div>
            </div>
          </div>
          <div class="conditions-group">
            <div class="conditions-group__label">
              <span id="conds-label" class="field-label">Conditions you live with</span>
              <span class="cond-desc">This helps us make sure we match you with the right expert.</span>
            </div>
            <div role="group" aria-labelledby="conds-label" class="pill-group">${condPills}</div>
            ${showCondText ? `
            <div class="intake-field-group" style="max-width:520px">
              <label for="intake-cond" class="field-label" style="font-size:15px">Add a condition</label>
              <div class="cond-add-row">
                <input id="intake-cond" class="field" data-bind="condText" placeholder="Type a condition and press Enter" value="${esc(state.condText)}" />
                <button type="button" class="btn btn-secondary btn-lg" data-action="add-cond" ${state.condText.trim() ? '' : 'disabled'}>Add</button>
              </div>
              ${state.custom.length ? `<div role="list" aria-label="Conditions you added" class="cond-chips">${chips}</div>` : ''}
            </div>` : ''}
          </div>
          <div class="intake-field-group">
            <label for="intake-other" class="field-label">Anything else you’d like us to know?</label>
            <textarea id="intake-other" data-bind="other" rows="3" class="field" placeholder="For example, what you’ve tried, what hasn’t worked, or what matters most to you right now.">${esc(state.other)}</textarea>
          </div>
        </div>`;
    }

    function renderContactStep() {
      const emailBad = state.emailTouched && state.email.trim().length > 0 && !emailOk(state.email);
      const ccOptions = CC.map(([v, l]) => `<option value="${v}"${state.cc === v ? ' selected' : ''}>${l}</option>`).join('');
      return `
        <div class="intake-contact-grid">
          <div class="intake-field-group">
            <label for="intake-first" class="field-label">First name<span aria-hidden="true" class="required-mark">*</span></label>
            <input id="intake-first" class="field" data-bind="first" autocomplete="given-name" placeholder="Alex" required value="${esc(state.first)}" />
          </div>
          <div class="intake-field-group">
            <label for="intake-last" class="field-label">Last name<span aria-hidden="true" class="required-mark">*</span></label>
            <input id="intake-last" class="field" data-bind="last" autocomplete="family-name" placeholder="Rivera" required value="${esc(state.last)}" />
          </div>
          <div class="intake-field-group intake-span-2" data-blur-target="email">
            <label for="intake-email" class="field-label">Email<span aria-hidden="true" class="required-mark">*</span></label>
            <input id="intake-email" type="text" inputmode="email" class="field${emailBad ? ' is-invalid' : ''}" data-bind="email" autocomplete="email" placeholder="you@example.com" required aria-invalid="${emailBad}" aria-describedby="email-error" value="${esc(state.email)}" />
            ${emailBad ? `<span id="email-error" role="alert" class="intake-error">Enter an email in the format name@example.com.</span>` : ''}
          </div>
          <div class="intake-field-group intake-span-2">
            <label for="intake-phone" class="field-label">Phone number</label>
            <div class="intake-phone-grid">
              <div class="select-wrap"><select id="intake-cc" data-bind="cc" aria-label="Country code" class="field">${ccOptions}</select></div>
              <input id="intake-phone" type="tel" class="field" data-bind="phone" autocomplete="tel-national" placeholder="(555) 123-4567" value="${esc(state.phone)}" />
            </div>
          </div>
        </div>`;
    }

    function renderReviewStep() {
      const conds = conditionsText();
      const cards = [
        { title: 'What you need help with', step: 0, rows: [{ k: 'Help with', v: state.needs.join(', ') || 'Not selected' }, state.notes.trim() && { k: 'Notes', v: state.notes.trim() }] },
        { title: 'About you', step: 1, rows: [{ k: 'State', v: state.st }, { k: 'Conditions', v: conds || 'Not provided' }, state.other.trim() && { k: 'Other', v: state.other.trim() }] },
        { title: 'Contact information', step: 2, rows: [{ k: 'Name', v: (state.first.trim() + ' ' + state.last.trim()).trim() }, { k: 'Email', v: state.email.trim() }, { k: 'Phone', v: state.phone.trim() ? state.cc + ' ' + state.phone.trim() : 'Not provided' }] }
      ];
      const cardsHtml = cards.map((c) => `
        <div class="review-card">
          <div class="review-card__head">
            <strong>${esc(c.title)}</strong>
            <button type="button" class="review-edit" data-action="edit-step" data-value="${c.step}" aria-label="Edit ${esc(c.title.toLowerCase())}">Edit</button>
          </div>
          ${c.rows.filter(Boolean).map((r) => `<div class="review-row"><span>${esc(r.k)}</span><span>${esc(r.v)}</span></div>`).join('')}
        </div>`).join('');
      const errorHtml = state.submitError ? `<p class="intake-error" role="alert" style="margin:0">Something went wrong. Please try again.</p>` : '';
      return `
        <div class="intake-section intake-section--review">
          ${cardsHtml}
          <p class="consent-line">By submitting, you agree to our <a href="/privacy">Privacy Policy</a>.</p>
          ${errorHtml}
        </div>`;
    }

    function renderDone() {
      const conds = conditionsText();
      const summary = [
        { k: 'Help with', v: state.needs.join(', ') || 'Not selected' },
        state.notes.trim() && { k: 'Notes', v: state.notes.trim() },
        { k: 'Name', v: (state.first.trim() + ' ' + state.last.trim()).trim() },
        state.phone.trim() && { k: 'Phone', v: state.cc + ' ' + state.phone.trim() },
        { k: 'State', v: state.st },
        conds && { k: 'Conditions', v: conds },
        state.other.trim() && { k: 'Other', v: state.other.trim() }
      ].filter(Boolean);
      return `
        <div class="done-wrap" role="status">
          <p class="eyebrow">Request received</p>
          <h2>Thanks for submitting, ${esc(state.first.trim() || 'there')}.</h2>
          <p>We’ll be in touch at <strong style="color:var(--navy-500)">${esc(state.email.trim())}</strong> about how our experts can support you.</p>
          <div class="summary-box">
            <span class="summary-box__title">What you shared</span>
            ${summary.map((s) => `<div class="summary-row"><span>${esc(s.k)}</span><span>${esc(s.v)}</span></div>`).join('')}
          </div>
          <div><button type="button" class="btn btn-ghost btn-lg restart-btn" data-action="restart">Start over</button></div>
        </div>`;
    }

    function render() {
      if (state.done) {
        body.innerHTML = renderDone();
        return;
      }
      const idx = Math.min(state.idx, STEPS.length - 1);
      const id = STEPS[idx];
      const { title, sub } = titleFor(id);
      const showProgress = idx > 0 || state.reached;
      const canBack = idx > 0;
      let stepHtml = '';
      if (id === 'need') stepHtml = renderNeedStep();
      else if (id === 'profile') stepHtml = renderProfileStep();
      else if (id === 'contact') stepHtml = renderContactStep();
      else stepHtml = renderReviewStep();

      const cta = ctaFor(id);
      const valid = validFor(id);
      const submitting = id === 'review' && state.submitting;
      const nextLabel = submitting ? 'Submitting…' : cta;

      body.innerHTML = `
        ${showProgress ? `
        <div class="intake-topbar">
          ${canBack ? `<button type="button" class="intake-back" data-action="back">← Back</button>` : '<span></span>'}
          <span class="intake-step-count">Step ${idx + 1} of ${STEPS.length}</span>
        </div>` : ''}
        <div class="intake-heading">
          <h2 id="q-title">${esc(title)}</h2>
          ${sub ? `<p>${esc(sub)}</p>` : ''}
        </div>
        ${stepHtml}
        <div class="intake-footer">
          <button type="button" class="btn btn-primary btn-lg" data-action="next" ${(!valid || submitting) ? 'disabled' : ''}>${esc(nextLabel)}</button>
        </div>`;
    }

    async function submitIntake() {
      const payload = {
        submittedAt: new Date().toISOString(),
        needs: state.needs,
        notes: state.notes.trim(),
        state: state.st,
        conditions: state.conds.filter((c) => c !== 'Something else'),
        customConditions: state.custom,
        other: state.other.trim(),
        firstName: state.first.trim(),
        lastName: state.last.trim(),
        email: state.email.trim(),
        countryCode: state.cc,
        phone: state.phone.trim(),
        source: 'homepage',
        website: websiteEl && websiteEl.value ? websiteEl.value : ''
      };
      const url = import.meta.env.PUBLIC_INTAKE_URL;
      state.submitting = true;
      state.submitError = false;
      render();
      try {
        if (url) {
          const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
          const data = await res.json().catch(() => ({}));
          if (!data.ok) throw new Error('submit failed');
        } else {
          // No PUBLIC_INTAKE_URL configured yet: log instead of sending anywhere.
          console.log('Krue intake submission (not yet connected to Google Sheets):', payload);
          await new Promise((r) => setTimeout(r, 400));
        }
        state.submitting = false;
        state.done = true;
        render();
      } catch (err) {
        state.submitting = false;
        state.submitError = true;
        render();
      }
    }

    function goStart(focusFirst) {
      const el = document.getElementById('start');
      if (!el) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 110, behavior: reduce ? 'auto' : 'smooth' });
      if (focusFirst) {
        setTimeout(() => {
          const target = body.querySelector('input, textarea, select, button[data-action]');
          if (target) target.focus({ preventScroll: true });
        }, reduce ? 0 : 500);
      }
    }

    body.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const action = btn.dataset.action;
      const value = btn.dataset.value;
      if (action === 'pick-need') {
        const sel = state.needs.includes(value);
        state.needs = sel ? state.needs.filter((x) => x !== value) : state.needs.filter((x) => x !== NOT_SURE).concat(value);
      } else if (action === 'pick-notsure') {
        state.needs = state.needs.includes(NOT_SURE) ? [] : [NOT_SURE];
      } else if (action === 'pick-cond') {
        const sel = state.conds.includes(value);
        state.conds = sel ? state.conds.filter((x) => x !== value) : [...state.conds, value];
      } else if (action === 'add-cond') {
        const v = state.condText.trim();
        if (v && !state.custom.some((x) => x.toLowerCase() === v.toLowerCase())) state.custom = [...state.custom, v];
        state.condText = '';
      } else if (action === 'remove-cond') {
        state.custom = state.custom.filter((x) => x !== value);
      } else if (action === 'back') {
        state.idx = Math.max(0, state.idx - 1);
      } else if (action === 'edit-step') {
        state.idx = Number(value);
      } else if (action === 'restart') {
        state = INIT();
      } else if (action === 'next') {
        const idx = Math.min(state.idx, STEPS.length - 1);
        const id = STEPS[idx];
        if (!validFor(id)) return;
        if (id === 'review') {
          submitIntake();
          return;
        }
        state.idx = idx + 1;
        state.reached = true;
      }
      render();
    });

    body.addEventListener('input', (e) => {
      const el = e.target.closest('[data-bind]');
      if (!el) return;
      const key = el.dataset.bind;
      if (key === 'phone') {
        state.phone = state.cc === '+1' ? fmtUS(el.value) : el.value.replace(/[^\d\s()-]/g, '');
      } else {
        state[key] = el.value;
      }
      // Re-render only the parts that need it, preserving focus for text inputs.
      // Some input types (e.g. email, number) don't support the selection API at
      // all — reading or setting selectionStart silently no-ops or returns null,
      // so always fall back to placing the caret at the end rather than leaving
      // it unset (which defaults to the start and reverses typed input).
      const active = document.activeElement;
      const activeId = active && active.id;
      let selStart = null;
      try {
        selStart = active && typeof active.selectionStart === 'number' ? active.selectionStart : null;
      } catch (err) {}
      render();
      if (activeId) {
        const toFocus = document.getElementById(activeId);
        if (toFocus) {
          toFocus.focus();
          const pos = selStart !== null ? selStart : (toFocus.value ? toFocus.value.length : 0);
          try { toFocus.setSelectionRange(pos, pos); } catch (err) {}
        }
      }
    });

    body.addEventListener('change', (e) => {
      const el = e.target.closest('[data-bind]');
      if (!el) return;
      const key = el.dataset.bind;
      if (key === 'cc') {
        state.cc = el.value;
        state.phone = el.value === '+1' ? fmtUS(state.phone) : state.phone;
      } else if (key === 'st') {
        state.st = el.value;
      }
      render();
    });

    body.addEventListener('focusout', (e) => {
      const wrap = e.target.closest('[data-blur-target="email"]');
      if (wrap && e.target.id === 'intake-email') {
        state.emailTouched = true;
        render();
      }
    });

    body.addEventListener('keydown', (e) => {
      if (e.target && e.target.id === 'intake-cond' && e.key === 'Enter') {
        e.preventDefault();
        const v = state.condText.trim();
        if (v && !state.custom.some((x) => x.toLowerCase() === v.toLowerCase())) state.custom = [...state.custom, v];
        state.condText = '';
        render();
      }
    });

    // External triggers: "Get help with this" cards and the final CTA box.
    window.addEventListener('krue:set-needs', (e) => {
      state.needs = (e.detail && e.detail.needs) || [];
      state.idx = 0;
      state.reached = false;
      state.done = false;
      render();
      goStart(true);
    });
    window.addEventListener('krue:jump-notes', (e) => {
      state.notes = (e.detail && e.detail.notes) || '';
      state.idx = 1;
      state.reached = true;
      state.done = false;
      render();
      goStart(false);
    });

    render();
  }

  const rootEl = document.getElementById('intake-card');
  if (rootEl) init(rootEl);
</script>
