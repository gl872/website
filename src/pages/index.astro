---
import Base from "../layouts/Base.astro";
import ClosingStart from "../components/ClosingStart.astro";

// Markup ported verbatim from the Concept A2 reference build (krue-site-handoff/krue-site/index.html).
// Behavior: src/scripts/home.js (hero untangle, How it works steps) and src/scripts/site.js (pop-ups).
---

<Base
  title="Krue · An advocate in your pocket"
  description="Krue helps people with complex chronic conditions get ready for appointments, keep track of what was said, and create one connected plan across their care."
  path="/"
>
  <main>
  <section id="top" class="h-sec h-hero">
  <div class="h-copy">
      <p class="h-eyebrow">For complex chronic illness</p>
      <h1 class="h-h1 h-wide">An <span class="k-hl" style="--hl:#C4EBF9">advocate</span> in your pocket</h1>
      <p class="h-intro">For people with large care teams and conditions that lack clear answers. Krue helps you get ready for appointments, keep track of what was said, and create one connected plan across your care.</p>
      <a class="h-cta" href="#start">Join the waitlist</a>
      <div class="h-row"><span class="h-pill" style="--bg:#E2F5FC;--fg:#1F7FA3;--bgh:#3ABAE8;--fgh:#14325A;">POTS</span><span class="h-pill" style="--bg:#FCE6F0;--fg:#A93E72;--bgh:#E2169E;--fgh:#FFFFFF;">hEDS</span><span class="h-pill" style="--bg:#F4F8D2;--fg:#6E7A0C;--bgh:#E0EE40;--fgh:#14325A;">MCAS</span><span class="h-pill" style="--bg:#FDF0DE;--fg:#9A5E14;--bgh:#F3B258;--fgh:#14325A;">ME/CFS</span><span class="h-pill" style="--bg:#E4EDF8;--fg:#235592;--bgh:#235592;--fgh:#FFFFFF;">Migraine</span><span class="h-pill" style="--bg:#F3E8F4;--fg:#7E4683;--bgh:#B555D9;--fgh:#FFFFFF;">Endometriosis</span><span class="h-pill" style="--bg:#fff;--fg:#14325A;--bgh:#14325A;--fgh:#fff;border:1.5px dashed #9AA3AF;">+ yours</span></div>
    </div>
  <div class="h-stage h-untangle" data-untangle="c" style="height:440px">
    <svg class="h-svg" viewBox="0 0 1200 440" preserveAspectRatio="none" aria-hidden="true"><path class="h-l" fill="none" stroke="#235592" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#7AD1EF" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#F290BA" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#E0EE40" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#F3B258" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#90C9B2" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#AC72B0" stroke-width="4" stroke-linecap="round"/><path class="h-l" fill="none" stroke="#F68B65" stroke-width="4" stroke-linecap="round"/></svg>
    <div class="h-phonewrap" style="top:30px">
      <div class="h-phone h-ps" role="img" aria-label="Krue prep sheet for Dr. Rao: two goals, a note about dizziness when standing, and a to-do">
        <div class="h-ps-top"><span class="h-ps-btn">←</span><span class="h-ps-btn">···</span></div>
        <div class="h-ps-card">
          <div class="h-ps-head"><b>Prep for Dr. Rao</b><span class="h-ps-chip">Draft</span></div>
          <div class="h-ps-meta">Rheumatology · Wed, Nov 4</div>
          <div class="h-ps-sec">Your goals</div>
          <div class="h-ps-goal"><span class="h-ps-n">1</span>Check if my dose is working</div>
          <div class="h-ps-goal"><span class="h-ps-n">2</span>Next steps for joint pain</div>
          <div class="h-ps-sec">What to bring up</div>
          <div class="h-ps-note"><b>Dizziness when I stand up</b><span class="h-ps-stat">Heart rate 72 → 124 standing</span><span class="h-ps-li">Using compression socks and salt tablets</span></div>
          <div class="h-ps-sec">To-do</div>
          <div class="h-ps-todo"><span class="h-ps-box"></span><span>Write down standing heart rate for 3 mornings<em>Due Mon</em></span></div>
        </div>
      </div>
      <div class="h-ocard h-land h-landL" style="left:-200px;top:140px"><span class="h-oeb">Linked to 3 appointments</span><ul class="h-tl"><li><span class="h-tld" style="background:#7AD1EF"></span><b>Neurology</b><em>Mar 12</em></li><li><span class="h-tld" style="background:#F290BA"></span><b>Cardiology</b><em>Apr 3</em></li><li><span class="h-tld" style="background:#E0EE40;box-shadow:0 0 0 4px #F4F8D2"></span><b>Rheumatology</b><em>Today</em></li></ul></div>
      <div class="h-ocard h-land h-landR" style="right:-200px;top:250px"><span class="h-oeb">Try saying it this way</span><span class="h-mold">“I get dizzy.”</span><span class="h-mnew">“I get lightheaded and have to sit down within 2 minutes of standing.”</span></div>
    </div>
  </div>
</section>

  <!-- HOW IT WORKS: one pinned phone, steps advance on scroll, a rainbow rail -->
  <section id="how" style="max-width:1180px;margin:0 auto;padding-left:clamp(16px,4vw,40px);padding-right:clamp(16px,4vw,40px);box-sizing:border-box;padding-top:clamp(80px,11vw,160px);padding-bottom:clamp(56px,7vw,96px)">
    <p style="margin:0 0 16px;font:700 13px/1 var(--font-display);letter-spacing:.16em;text-transform:uppercase;color:#69727F">How it works</p>
    <h2 style="margin:0;font:800 clamp(34px,4.6vw,58px)/1.04 var(--font-display);letter-spacing:-0.035em;color:#14325A;text-wrap:balance;max-width:18ch">Walk in prepared. Walk out <span class="k-hl" style="--hl:#CFE8DD">with a plan.</span></h2>
    <div class="k-how-row" style="display:flex;flex-wrap:wrap;gap:clamp(40px,6vw,96px);margin-top:clamp(32px,5vw,56px)">
      <div style="flex:1 1 380px;min-width:0;position:relative;padding-left:32px">
        
        
          <div class="k-step" data-step="0" style="position:relative;min-height:clamp(260px,52vh,460px);display:flex;flex-direction:column;justify-content:center"><span aria-hidden="true" class="k-rail" style="position:absolute;left:-32px;top:6px;bottom:6px;width:6px;border-radius:3px;background:var(--cur0)"></span>
            <span class="k-num" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:var(--cur0);font:800 15px/1 var(--font-display);color:var(--curfg0)">01</span>
            <h3 style="margin:14px 0 0;font:800 clamp(30px,3.4vw,44px)/1.05 var(--font-display);letter-spacing:-0.03em;color:#14325A">Get ready</h3>
            <p style="margin:0;font:400 clamp(17px,1.4vw,19px)/1.6 var(--font-body);color:#3B4656;text-wrap:pretty;margin-top:14px;max-width:28rem">Tell Krue what&#x27;s going on. Krue connects the dots across your appointments. It helps you set goals, know what to do first, and plan what to say.</p>
            <div class="k-inline-phone" style="margin-top:28px;justify-content:center">
              <div style="position:relative;overflow:hidden;width:min(280px,100%);aspect-ratio:402/874;border-radius:40px;background:#F4F6FA;border:9px solid #14325A;box-shadow:0 4px 10px rgba(20,50,90,0.08), 0 28px 56px rgba(20,50,90,0.16);box-sizing:border-box"><div class="s-scr"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Prep for Dr. Rao</b><span>Rheumatology · Wed, Nov 4</span></div><span class="s-btn">···</span></div>
<div class="s-body">
  <div class="s-b s-krue">What's changed since your last appointment?</div>
  <div class="s-b s-me">Dizzier in the mornings, and my knee is worse.</div>
  <div class="s-b s-krue">Got it. I added both to your prep sheet so they don't get lost.</div>
  <span class="s-chip s-chip-ok">✓ Prep sheet updated</span>
</div><div class="s-input"><span>Tell Krue what's going on</span><span class="s-mic">●</span></div></div></div>
              <div class="s-pop" style="right:-120px;top:345px;--c:#7AD1EF"><span class="s-peb">Added to your prep</span><span class="s-prow"><span class="s-pd"></span>Morning dizziness</span><span class="s-prow"><span class="s-pd"></span>Knee pain</span></div>
            </div>
          </div>
        
          <div class="k-step" data-step="1" style="position:relative;min-height:clamp(260px,52vh,460px);display:flex;flex-direction:column;justify-content:center"><span aria-hidden="true" class="k-rail" style="position:absolute;left:-32px;top:6px;bottom:6px;width:6px;border-radius:3px;background:var(--cur1)"></span>
            <span class="k-num" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:var(--cur1);font:800 15px/1 var(--font-display);color:var(--curfg1)">02</span>
            <h3 style="margin:14px 0 0;font:800 clamp(30px,3.4vw,44px)/1.05 var(--font-display);letter-spacing:-0.03em;color:#14325A">Capture it</h3>
            <p style="margin:0;font:400 clamp(17px,1.4vw,19px)/1.6 var(--font-body);color:#3B4656;text-wrap:pretty;margin-top:14px;max-width:28rem">Record the appointment and add notes. Krue writes down what was said.</p>
            <div class="k-inline-phone" style="margin-top:28px;justify-content:center">
              <div style="position:relative;overflow:hidden;width:min(280px,100%);aspect-ratio:402/874;border-radius:40px;background:#F4F6FA;border:9px solid #14325A;box-shadow:0 4px 10px rgba(20,50,90,0.08), 0 28px 56px rgba(20,50,90,0.16);box-sizing:border-box"><div class="s-scr"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Neurology</b><span>Dr. Dougan · Today</span></div><span class="s-btn">···</span></div>
<div class="s-body">
  <span class="s-chip s-chip-ok">✓ Provider agreed to recording</span>
  <div class="s-timer">12:48</div>
  <div class="s-wave"><i style="height:10px"></i><i style="height:22px"></i><i style="height:14px"></i><i style="height:30px"></i><i style="height:18px"></i><i style="height:36px"></i><i style="height:24px"></i><i style="height:12px"></i><i style="height:28px"></i><i style="height:40px"></i><i style="height:20px"></i><i style="height:16px"></i><i style="height:32px"></i><i style="height:22px"></i><i style="height:12px"></i><i style="height:26px"></i><i style="height:34px"></i><i style="height:18px"></i><i style="height:10px"></i><i style="height:24px"></i></div>
  <div class="s-sec">Live notes</div>
  <div class="s-notes"><span>Dizziness worse in the mornings</span><span>Keep compression socks</span><span class="s-new">Recheck heart rate in 4 weeks</span></div>
</div>
<div class="s-stopbar"><span class="s-stop"></span><span>Recording</span></div></div></div>
              <div class="s-pop" style="left:-120px;top:395px;--c:#E0EE40"><span class="s-peb">Note added · 12:48</span><b>Recheck heart rate in 4 weeks</b></div>
            </div>
          </div>
        
          <div class="k-step" data-step="2" style="position:relative;min-height:clamp(260px,52vh,460px);display:flex;flex-direction:column;justify-content:center"><span aria-hidden="true" class="k-rail" style="position:absolute;left:-32px;top:6px;bottom:6px;width:6px;border-radius:3px;background:var(--cur2)"></span>
            <span class="k-num" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:var(--cur2);font:800 15px/1 var(--font-display);color:var(--curfg2)">03</span>
            <h3 style="margin:14px 0 0;font:800 clamp(30px,3.4vw,44px)/1.05 var(--font-display);letter-spacing:-0.03em;color:#14325A">One plan</h3>
            <p style="margin:0;font:400 clamp(17px,1.4vw,19px)/1.6 var(--font-body);color:#3B4656;text-wrap:pretty;margin-top:14px;max-width:28rem">Next steps from every appointment go in one list. Tests, referrals, who to see next, and things to try.</p>
            <div class="k-inline-phone" style="margin-top:28px;justify-content:center">
              <div style="position:relative;overflow:hidden;width:min(280px,100%);aspect-ratio:402/874;border-radius:40px;background:#F4F6FA;border:9px solid #14325A;box-shadow:0 4px 10px rgba(20,50,90,0.08), 0 28px 56px rgba(20,50,90,0.16);box-sizing:border-box"><div class="s-scr"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Actions</b></div><span class="s-btn">···</span></div>
<div class="s-body s-acts">
  <div class="s-grp"><span class="s-dot" style="background:#7AD1EF"></span>Neurology</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Book tilt table test</b><em>From Mar 12 visit</em></span><span class='s-tag s-od'>Overdue</span></div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Send symptom log</b><em>Before next visit</em></span></div>
  <div class="s-grp"><span class="s-dot" style="background:#F290BA"></span>Primary care</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Get labs drawn</b><em>Ferritin, vitamin D</em></span><span class='s-tag '>Sat</span></div>
  <div class="s-grp"><span class="s-dot" style="background:#90C9B2"></span>Physical therapy</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Knee routine, 3x a week</b><em>From Oct 14 visit</em></span><span class='s-tag s-td'>Today</span></div>
</div></div></div>
              <div class="s-pop s-popcheck" style="right:-130px;top:100px;--c:#F290BA"><span class="s-ck">✓</span><span><b>Book tilt table test</b><em>from Neurology</em></span></div>
            </div>
          </div>
        
          <div class="k-step" data-step="3" style="position:relative;min-height:clamp(260px,52vh,460px);display:flex;flex-direction:column;justify-content:center"><span aria-hidden="true" class="k-rail" style="position:absolute;left:-32px;top:6px;bottom:6px;width:6px;border-radius:3px;background:var(--cur3)"></span>
            <span class="k-num" style="align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:var(--cur3);font:800 15px/1 var(--font-display);color:var(--curfg3)">04</span>
            <h3 style="margin:14px 0 0;font:800 clamp(30px,3.4vw,44px)/1.05 var(--font-display);letter-spacing:-0.03em;color:#14325A">Find your next step</h3>
            <p style="margin:0;font:400 clamp(17px,1.4vw,19px)/1.6 var(--font-body);color:#3B4656;text-wrap:pretty;margin-top:14px;max-width:28rem">Ask Krue about what was said. Get reminders for what&#x27;s left to do. Start your next appointment where the last one ended.</p>
            <div class="k-inline-phone" style="margin-top:28px;justify-content:center">
              <div style="position:relative;overflow:hidden;width:min(280px,100%);aspect-ratio:402/874;border-radius:40px;background:#F4F6FA;border:9px solid #14325A;box-shadow:0 4px 10px rgba(20,50,90,0.08), 0 28px 56px rgba(20,50,90,0.16);box-sizing:border-box"><div class="s-scr"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Ask Krue</b></div><span class="s-btn">···</span></div>
<div class="s-body">
  <div class="s-b s-me">What did PT say about my knee?</div>
  <div class="s-ans"><span class="s-src">From Physical therapy · Oct 14</span><p>Start the knee strengthening routine, 3 times a week. Your PT wants to check in after 4 weeks.</p><span class="s-link">See full notes →</span></div>
</div><div class="s-input"><span>Ask about any appointment</span><span class="s-mic">●</span></div></div></div>
              <div class="s-pop s-popdark" style="left:-130px;top:330px"><span class="s-peb">Reminder</span><b>Send your BP log to Dr. Rao before Wed</b></div>
            </div>
          </div>
        
      </div>
      <div class="k-pinned" style="flex:1 1 380px;min-width:0">
        <div style="position:sticky;top:110px;height:min(78vh,700px);display:flex;align-items:center;justify-content:center">
          <div style="position:relative"><div aria-hidden="true" style="position:absolute;left:-70px;top:12%;width:440px;height:76%;background:var(--activeTint);border-radius:58% 42% 52% 48% / 48% 58% 42% 52%;transition:background 400ms cubic-bezier(0.16,1,0.3,1);z-index:0"></div>
            <div style="position:relative;z-index:1;width:300px;aspect-ratio:402/874;border-radius:46px;background:#F4F6FA;border:10px solid #14325A;box-shadow:0 4px 10px rgba(20,50,90,0.08), 0 28px 56px rgba(20,50,90,0.16);box-sizing:border-box;overflow:hidden">
              <div class="s-scr" style="opacity:var(--so0)"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Prep for Dr. Rao</b><span>Rheumatology · Wed, Nov 4</span></div><span class="s-btn">···</span></div>
<div class="s-body">
  <div class="s-b s-krue">What's changed since your last appointment?</div>
  <div class="s-b s-me">Dizzier in the mornings, and my knee is worse.</div>
  <div class="s-b s-krue">Got it. I added both to your prep sheet so they don't get lost.</div>
  <span class="s-chip s-chip-ok">✓ Prep sheet updated</span>
</div><div class="s-input"><span>Tell Krue what's going on</span><span class="s-mic">●</span></div></div>
              <div class="s-scr" style="opacity:var(--so1)"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Neurology</b><span>Dr. Dougan · Today</span></div><span class="s-btn">···</span></div>
<div class="s-body">
  <span class="s-chip s-chip-ok">✓ Provider agreed to recording</span>
  <div class="s-timer">12:48</div>
  <div class="s-wave"><i style="height:10px"></i><i style="height:22px"></i><i style="height:14px"></i><i style="height:30px"></i><i style="height:18px"></i><i style="height:36px"></i><i style="height:24px"></i><i style="height:12px"></i><i style="height:28px"></i><i style="height:40px"></i><i style="height:20px"></i><i style="height:16px"></i><i style="height:32px"></i><i style="height:22px"></i><i style="height:12px"></i><i style="height:26px"></i><i style="height:34px"></i><i style="height:18px"></i><i style="height:10px"></i><i style="height:24px"></i></div>
  <div class="s-sec">Live notes</div>
  <div class="s-notes"><span>Dizziness worse in the mornings</span><span>Keep compression socks</span><span class="s-new">Recheck heart rate in 4 weeks</span></div>
</div>
<div class="s-stopbar"><span class="s-stop"></span><span>Recording</span></div></div>
              <div class="s-scr" style="opacity:var(--so2)"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Actions</b></div><span class="s-btn">···</span></div>
<div class="s-body s-acts">
  <div class="s-grp"><span class="s-dot" style="background:#7AD1EF"></span>Neurology</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Book tilt table test</b><em>From Mar 12 visit</em></span><span class='s-tag s-od'>Overdue</span></div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Send symptom log</b><em>Before next visit</em></span></div>
  <div class="s-grp"><span class="s-dot" style="background:#F290BA"></span>Primary care</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Get labs drawn</b><em>Ferritin, vitamin D</em></span><span class='s-tag '>Sat</span></div>
  <div class="s-grp"><span class="s-dot" style="background:#90C9B2"></span>Physical therapy</div>
  <div class="s-act"><span class="s-box"></span><span class="s-at"><b>Knee routine, 3x a week</b><em>From Oct 14 visit</em></span><span class='s-tag s-td'>Today</span></div>
</div></div>
              <div class="s-scr" style="opacity:var(--so3)"><div class="s-top"><span class="s-btn">←</span><div class="s-ttl"><b>Ask Krue</b></div><span class="s-btn">···</span></div>
<div class="s-body">
  <div class="s-b s-me">What did PT say about my knee?</div>
  <div class="s-ans"><span class="s-src">From Physical therapy · Oct 14</span><p>Start the knee strengthening routine, 3 times a week. Your PT wants to check in after 4 weeks.</p><span class="s-link">See full notes →</span></div>
</div><div class="s-input"><span>Ask about any appointment</span><span class="s-mic">●</span></div></div>
            </div>
            <div class="s-pinpop" style="position:absolute;inset:0;z-index:2;opacity:var(--so0);translate:0 var(--sy0)"><div class="s-pop" style="right:-55px;top:75%;transform:translateY(-50%);--c:#7AD1EF"><span class="s-peb">Added to your prep</span><span class="s-prow"><span class="s-pd"></span>Morning dizziness</span><span class="s-prow"><span class="s-pd"></span>Knee pain</span></div></div>
            <div class="s-pinpop" style="position:absolute;inset:0;z-index:2;opacity:var(--so1);translate:0 var(--sy1)"><div class="s-pop" style="right:-55px;top:75%;transform:translateY(-50%);--c:#E0EE40"><span class="s-peb">Note added · 12:48</span><b>Recheck heart rate in 4 weeks</b></div></div>
            <div class="s-pinpop" style="position:absolute;inset:0;z-index:2;opacity:var(--so2);translate:0 var(--sy2)"><div class="s-pop s-popcheck" style="right:-55px;top:75%;transform:translateY(-50%);--c:#F290BA"><span class="s-ck">✓</span><span><b>Book tilt table test</b><em>from Neurology</em></span></div></div>
            <div class="s-pinpop" style="position:absolute;inset:0;z-index:2;opacity:var(--so3);translate:0 var(--sy3)"><div class="s-pop s-popdark" style="right:-55px;top:75%;transform:translateY(-50%)"><span class="s-peb">Reminder</span><b>Send your BP log to Dr. Rao before Wed</b></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS: one bold statement on a navy band -->
  <section class="q-band" style="margin-top:clamp(80px,11vw,140px)">
    <div class="q-band-in">
      <p class="q-band-s"><span style="color:#E0EE40">2 in 3</span> people leave an appointment with questions they forgot to ask.</p>
      <p class="q-band-src">Wolters Kluwer survey of 1,034 US adults, 2023</p>
    </div>
  </section>

  <!-- PATIENT EXPERIENCES: pilot testimonials -->
<section style="max-width:1180px;margin:0 auto;padding-left:clamp(16px,4vw,40px);padding-right:clamp(16px,4vw,40px);box-sizing:border-box;padding-top:clamp(72px,9vw,120px)">
    <div class="i-head"><p class="i-eb">Patient experiences</p><h2 class="i-h2">A little more support can <span class="k-hl" style="--hl:#F9D3E4">make a difference.</span></h2><p class="q-sub">Here’s what people experienced during Krue’s early pilot.</p></div>
    <div class="q-grid">
      <figure class="q-card" style="--qc:#F290BA"><span class="q-mark" aria-hidden="true">“</span><h3 class="q-h">I remembered what mattered.</h3><blockquote class="q-b">“I was in such a brain fog. There were things in your notes I’d completely forgotten about. Then I saw them and thought, ‘Oh my God, yes, I need to ask about this.’”</blockquote><figcaption class="q-cap">Pilot participant<span class="q-cond">POTS, hEDS, histamine intolerance</span></figcaption></figure>
      <figure class="q-card" style="--qc:#7AD1EF"><span class="q-mark" aria-hidden="true">“</span><h3 class="q-h">I didn’t have to figure it all out alone.</h3><blockquote class="q-b">“Having somewhere to put everything, all these thoughts and symptoms, was a big help. And having someone I could relate to made a difference.”</blockquote><figcaption class="q-cap">Pilot participant<span class="q-cond">hEDS, endometriosis, migraine, POTS, MCAS</span></figcaption></figure>
      <figure class="q-card" style="--qc:#90C9B2"><span class="q-mark" aria-hidden="true">“</span><h3 class="q-h">I went into my appointment feeling prepared.</h3><blockquote class="q-b">“I reviewed it before my appointment, then again a few minutes beforehand. I went in with what I’d taken away from everything we’d talked through.”</blockquote><figcaption class="q-cap">Pilot participant<span class="q-cond">Dysautonomia, psoriatic arthritis</span></figcaption></figure>
    </div>
