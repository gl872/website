---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import author from "../../data/author.json";
import ClosingBand from "../../components/ClosingBand.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const siteUrl = Astro.site ?? new URL("https://krue.io");
const postUrl = new URL(`/blog/${post.id}`, siteUrl).toString();
const postImage = post.data.cover
  ? new URL(post.data.cover, siteUrl).toString()
  : new URL("/og-image.png", siteUrl).toString();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  articleSection: post.data.type,
  inLanguage: "en-US",
  image: postImage,
  url: postUrl,
  mainEntityOfPage: postUrl,
  author: { "@type": "Person", name: author.name, jobTitle: author.role },
  publisher: {
    "@type": "Organization",
    name: "Krue",
    logo: { "@type": "ImageObject", url: new URL("/assets/logos/krue-wordmark-navy.png", siteUrl).toString() },
  },
};
---

<Base title={`${post.data.title} · Krue`} description={post.data.excerpt} path={`/blog/${post.id}`} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <div class="page">
    <Header />
    <main>
      <article class="post">
        <a href="/blog" class="post__back">&larr; All posts</a>
        <div class="post__head">
          <span class="post__tag">{post.data.type}</span>
          <h1>{post.data.title}</h1>
        </div>
        <div class="post__byline">
          <div class="post__author">
            <img src={author.photo} alt={author.name} class="post__author-photo" />
            <div class="post__author-info">
              <span class="post__author-name">{author.name}</span>
              <span class="post__author-role">{author.role}</span>
              <span class="post__author-date">{dateLabel}</span>
            </div>
          </div>
          <ShareButtons title={post.data.title} />
        </div>
        <div class="post__body">
          <Content />
        </div>
      </article>
      <ClosingBand />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .page { min-height: 100vh; background: var(--surface-cream); color: #3A4350; font-family: var(--font-body); display: flex; flex-direction: column; }
  main { flex: 1; }

  .post { max-width: 720px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(20px, 4vw, 40px) clamp(72px, 9vw, 128px); display: flex; flex-direction: column; gap: 28px; }
  .post__back { align-self: flex-start; min-height: 44px; display: inline-flex; align-items: center; color: #242B35; font: 600 15px var(--font-display); text-decoration: none; }
  .post__back:hover { color: #BC5230; }

  .post__head { display: flex; flex-direction: column; gap: 18px; }
  .post__tag { align-self: flex-start; font: 600 14px/1.2 var(--font-body); color: #525C6B; }
  .post__head h1 { margin: 0; font: 700 clamp(34px, 4.6vw, 52px)/1.08 var(--font-display); letter-spacing: -0.03em; color: #242B35; text-wrap: balance; }

  .post__byline { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; padding: 18px 0; border-top: 1px solid var(--border-warm); border-bottom: 1px solid var(--border-warm); }
  .post__author { display: flex; align-items: center; gap: 14px; }
  .post__author-photo { width: 56px; height: 56px; border-radius: 999px; object-fit: cover; flex: none; background: #DAF1FD; }
  .post__author-info { display: flex; flex-direction: column; gap: 2px; }
  .post__author-name { font: 600 16px var(--font-display); color: #242B35; }
  .post__author-role { font-size: 15px; color: #525C6B; }
  .post__author-date { font-size: 14px; font-weight: 600; color: #5F6B7D; }

  .post__body { display: flex; flex-direction: column; gap: 22px; font-size: 18px; line-height: 1.7; color: #3A4350; }
  .post__body :global(h2) { margin: 12px 0 0; font: 700 28px/1.2 var(--font-display); letter-spacing: -0.02em; color: #242B35; }
  .post__body :global(h3) { margin: 8px 0 0; font: 700 22px/1.25 var(--font-display); color: #242B35; }
  .post__body :global(p) { margin: 0; }
  .post__body :global(ul), .post__body :global(ol) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }
  .post__body :global(figure) { margin: 8px 0; display: flex; flex-direction: column; gap: 10px; }
  .post__body :global(figure img) { width: 100%; border-radius: 20px; display: block; }
  .post__body :global(figcaption) { font-size: 15px; color: #525C6B; }
  .post__body :global(a) { color: #242B35; font-weight: 600; }
  .post__body :global(a:hover) { color: #BC5230; }
</style>
