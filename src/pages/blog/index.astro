---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ClosingBand from "../../components/ClosingBand.astro";

const FILTERS = ["All", "Company news", "Articles", "Practical guides"];

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const hasPosts = posts.length > 0;
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Base
  title="Blog · Krue"
  description="Updates on what we're building, and practical ideas for everyday life with chronic illness."
  path="/blog"
>
  <div class="page">
    <Header />
    <main>
      <section class="blog container">
        <h1>Notes from Krue.</h1>
        <p class="blog__intro">Updates on what we’re building, and practical ideas for everyday life with chronic illness.</p>

        {hasPosts && (
          <div role="group" aria-label="Filter by type" class="tabs">
            {FILTERS.map((f, i) => (
              <button type="button" class="tab" data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>{f}</button>
            ))}
          </div>
        )}

        {hasPosts && (
          <div id="posts" class="posts">
            {posts.map((post, i) => (
              <article class:list={["post", i === 0 ? "is-featured" : "is-row"]} data-type={post.data.type}>
                <div class="post__img">
                  {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt || ""} loading="lazy" />}
                </div>
                <div class="post__type">{post.data.type}</div>
                <div class="post__main">
                  <div class="post__meta"><span>{post.data.type}</span><span aria-hidden="true">·</span><span>{fmt(post.data.date)}</span></div>
                  <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
                  <p class="post__excerpt">{post.data.excerpt}</p>
                  <span class="post__date">{fmt(post.data.date)}</span>
                </div>
              </article>
            ))}
          </div>
        )}

        <p id="empty" class="empty" hidden={hasPosts}>Nothing here yet.</p>
      </section>

      <ClosingBand />
    </main>
    <Footer />
  </div>
</Base>

<style>
  .page { min-height: 100vh; background: var(--surface-cream); color: #3A4350; font-family: var(--font-body); display: flex; flex-direction: column; }
  main { flex: 1; }

  .blog { padding-top: clamp(48px, 8vw, 112px); padding-bottom: clamp(80px, 10vw, 140px); }
  .blog h1 { margin: 0; font: 700 clamp(44px, 8vw, 96px)/1 var(--font-display); letter-spacing: -0.035em; color: #242B35; max-width: 13ch; text-wrap: balance; }
  .blog__intro { margin: 24px 0 0; max-width: 36ch; font-size: clamp(19px, 1.8vw, 22px); line-height: 1.5; color: #3A4350; text-wrap: pretty; }

  .tabs { margin-top: clamp(48px, 6vw, 72px); display: flex; flex-wrap: wrap; gap: 4px 28px; border-bottom: 1px solid var(--border-warm); }
  .tab { min-height: 48px; padding: 0; margin-bottom: -1px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #5F6B7D; font: 600 16px/1 var(--font-display); cursor: pointer; }
  .tab:hover { color: #242B35; }
  .tab[aria-pressed="true"] { color: #242B35; border-bottom-color: #F68B65; }

  .posts { margin-top: clamp(40px, 5vw, 64px); display: flex; flex-direction: column; }
  .post[hidden] { display: none; }

  .post h2 { margin: 0; text-wrap: balance; }
  .post h2 a { color: #242B35; text-decoration: none; }
  .post h2 a:hover { color: #BC5230; }
  .post__excerpt { margin: 0; color: #3A4350; text-wrap: pretty; }

  /* Featured */
  .post.is-featured { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .is-featured .post__img { aspect-ratio: 4 / 3; border-radius: 24px; overflow: hidden; background: var(--surface-peach); }
  .is-featured .post__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .is-featured .post__type, .is-featured .post__date { display: none; }
  .is-featured .post__main { display: flex; flex-direction: column; gap: 16px; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font: 600 14px/1.2 var(--font-body); color: #525C6B; }
  .is-featured h2 { font: 700 clamp(30px, 4vw, 48px)/1.06 var(--font-display); letter-spacing: -0.03em; }
  .is-featured .post__excerpt { max-width: 44ch; font-size: 18px; line-height: 1.55; }

  /* Rows */
  .post.is-row { margin-top: 0; border-top: 1px solid var(--border-warm); padding-block: clamp(24px, 3vw, 36px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px clamp(24px, 4vw, 56px); align-items: baseline; }
  .is-row .post__img, .is-row .post__meta { display: none; }
  .is-row .post__type { font: 600 14px/1.2 var(--font-body); color: #525C6B; }
  .is-row .post__main { grid-column: span 2 / auto; display: flex; flex-direction: column; gap: 10px; }
  .is-row h2 { font: 700 clamp(24px, 2.8vw, 32px)/1.12 var(--font-display); letter-spacing: -0.02em; }
  .is-row .post__excerpt { max-width: 56ch; font-size: 17px; line-height: 1.55; }
  .is-row .post__date { font-size: 14px; line-height: 1.4; color: #5F6B7D; }
  .post.is-row:first-child { margin-top: 0; }
  .is-featured + .is-row, .is-row + .is-row { }
  .post.is-featured + .post.is-row { margin-top: clamp(48px, 6vw, 80px); }

  .empty { margin: 0; border-top: 1px solid var(--border-warm); padding: 40px 0; font-size: 18px; line-height: 1.5; color: #525C6B; }
  .empty[hidden] { display: none; }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tab"));
  const posts = Array.from(document.querySelectorAll<HTMLElement>(".post"));
  const empty = document.getElementById("empty");

  function apply(filter: string) {
    let first = true;
    posts.forEach((p) => {
      const show = filter === "All" || p.dataset.type === filter;
      p.hidden = !show;
      if (!show) return;
      p.classList.toggle("is-featured", first);
      p.classList.toggle("is-row", !first);
      first = false;
    });
    if (empty) empty.hidden = !first;
  }

  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      tabs.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
      apply(t.dataset.filter || "All");
    })
  );
</script>
