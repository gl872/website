  .team-dot.is-active { width: 20px; background: var(--navy-500); transition: width 220ms ease, background 220ms ease; }

  @media (max-width: 640px) {
    .team-grid { display: flex; grid-template-columns: none; max-width: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .team-grid::-webkit-scrollbar { display: none; }
