</style>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const toggle = target.closest('.need-toggle') as HTMLElement | null;
    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute('aria-controls') || '');
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      const cue = toggle.querySelector('.need-toggle__cue');
      if (cue) cue.textContent = expanded ? 'Learn more' : 'Show less';
      if (panel) panel.hidden = expanded;
      return;
    }

    const topicBtn = target.closest('[data-topics]') as HTMLElement | null;
    if (topicBtn) {
      const topics = JSON.parse(topicBtn.dataset.topics || '[]');
      window.dispatchEvent(new CustomEvent('krue:pick-topic', { detail: { topics } }));
    }
  });

  const teamGrid = document.getElementById('team-grid');
  const teamDots = Array.from(document.querySelectorAll<HTMLButtonElement>('.team-dot'));
  if (teamGrid && teamDots.length) {
    const cards = Array.from(teamGrid.querySelectorAll<HTMLElement>('.team-card'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setActive = (i: number) => {
      teamDots.forEach((d, di) => d.classList.toggle('is-active', di === i));
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const i = cards.indexOf(entry.target as HTMLElement);
          if (i !== -1) setActive(i);
        }
      });
    }, { root: teamGrid, threshold: 0.6 });
    cards.forEach((c) => observer.observe(c));

    teamDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        cards[i]?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', inline: 'center', block: 'nearest' });
      });
    });

    setActive(0);
  }

  // Keep the 4 "How Krue works" preview boxes the same height as each
  // other, whatever their content needs — recalculated on resize/breakpoint
  // change and after fonts load, instead of a hard-coded pixel guess.
  const howMocks = Array.from(document.querySelectorAll<HTMLElement>('.how__mock'));
  if (howMocks.length) {
    const equalizeHowMocks = () => {
      howMocks.forEach((el) => { el.style.height = 'auto'; });
      const max = Math.max(...howMocks.map((el) => el.getBoundingClientRect().height));
      howMocks.forEach((el) => { el.style.height = `${max}px`; });
    };

    equalizeHowMocks();
    if ('fonts' in document) (document as any).fonts.ready.then(equalizeHowMocks);

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(equalizeHowMocks, 150);
    });
  }
</script>
