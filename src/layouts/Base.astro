---
import "../styles/tokens.css";
import "../styles/site.css";
import Analytics from "../components/Analytics.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: "website" | "article";
  /** Absolute or root-relative image for social cards. Defaults to /og-image.png. */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, path = "/", ogType = "website", ogImage = "/og-image.png", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://krue.io");
const canonical = new URL(path, site);
const ogImageUrl = new URL(ogImage, site);
const isDefaultOg = ogImage === "/og-image.png";
const siteUrl = new URL("/", site);

const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Krue",
      url: siteUrl.toString(),
      logo: new URL("/assets/logos/krue-icon.png", siteUrl).toString(),
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "Krue",
      url: siteUrl.toString(),
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {import.meta.env.PUBLIC_GSC_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700;800&family=Figtree:wght@400;500;600;700&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Krue" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    {isDefaultOg && <meta property="og:image:alt" content="Krue · An advocate in your pocket." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <Analytics placement="head" />

    <slot name="head" />
  </head>
  <body>
    <Analytics placement="body" />
    <div style="background:#FBF8F4;min-height:100vh;font-family:var(--font-body);color:#14325A;overflow-x:clip">
      <Header />
      <slot />
      <Footer />
    </div>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
